---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import GlobalNav from '../components/GlobalNav.astro';
import SubNav from '../components/SubNav.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Footer from '../components/Footer.astro';
import RewardedAdGate from '../components/RewardedAdGate.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	ogType?: string;
	keywords?: string | string[];
	publishedTime?: string;
	modifiedTime?: string;
	articleAuthor?: string;
	noindex?: boolean;
}

const { 
	title = "Learn SAP Free - Master SAP ABAP, Fiori, HANA, BTP Tutorials", 
	description = "Learn SAP for free with step-by-step tutorials on ABAP programming, SAP Fiori, HANA, BTP, and Basis. Daily bite-sized tips, transaction codes, quizzes, and hands-on guides.",
	image = "/logo.png",
	ogType = "website",
	keywords,
	publishedTime,
	modifiedTime,
	articleAuthor,
	noindex = false,
} = Astro.props;

const siteName = 'Learn SAP Free';
const siteUrl = 'https://learnsapfree.com';

// Astro.site is a URL object (or undefined) when configured in astro.config.mjs.
let cleanPathname = Astro.url.pathname;
if (cleanPathname.endsWith('/') && cleanPathname !== '/') {
	cleanPathname = cleanPathname.slice(0, -1);
}
if (cleanPathname.endsWith('.html')) {
	cleanPathname = cleanPathname.slice(0, -5);
}
const canonicalUrl = Astro.site
	? new URL(cleanPathname, Astro.site).toString()
	: undefined;

// Resolve absolute image URL for metadata crawlers
const absoluteImageUrl = Astro.site
	? new URL(image, Astro.site).toString()
	: image;

// Build global client search data index
const allBlogPosts = await getCollection('blog');
const searchIndexData = allBlogPosts.map(post => ({
    type: 'Guide',
    title: post.data.title,
    desc: post.data.description,
    url: `/blog/${post.id}`,
    category: post.data.category
}));

// Robots directive
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// JSON-LD Organization schema (appears on every page)
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": siteName,
	"url": siteUrl,
	"logo": `${siteUrl}/logo.png`,
	"description": "Free SAP training platform offering tutorials on ABAP, Fiori, HANA, BTP, and Basis administration.",
	"sameAs": [
		"https://www.youtube.com/channel/UCTivqSC8zUouAkk-YZEqnKg",
		"https://github.com/dakshdedha0001"
	],
	"contactPoint": {
		"@type": "ContactPoint",
		"contactType": "customer support",
		"url": `${siteUrl}/contact`,
		"availableLanguage": "English"
	}
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<!-- Theme Detection and Initialization (Anti-Flash) -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>

		<!-- Google AdSense verification & auto ads -->
		<meta name="google-adsense-account" content="ca-pub-5063580372617604" />
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5063580372617604" crossorigin="anonymous"></script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Favicons & Icons -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<!-- Sitemap Discovery -->
		<link rel="sitemap" href="/sitemap.xml" />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		{keywords ? (
			<meta name="keywords" content={Array.isArray(keywords) ? keywords.join(', ') : keywords} />
		) : null}
		<meta name="author" content={siteName} />
		<meta name="robots" content={robotsContent} />
		<meta name="googlebot" content={robotsContent} />
		<meta name="theme-color" content="#0066cc" />
		<meta name="publisher" content={siteName} />

		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
		<meta property="og:image" content={absoluteImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />

		<!-- Article-specific Open Graph tags -->
		{ogType === 'article' && publishedTime ? (
			<meta property="article:published_time" content={publishedTime} />
		) : null}
		{ogType === 'article' && modifiedTime ? (
			<meta property="article:modified_time" content={modifiedTime} />
		) : null}
		{ogType === 'article' && articleAuthor ? (
			<meta property="article:author" content={articleAuthor} />
		) : null}
		{ogType === 'article' ? (
			<meta property="article:section" content="SAP Training" />
		) : null}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImageUrl} />
		<meta name="twitter:image:alt" content={title} />

		<!-- JSON-LD Organization Schema (Global) -->
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

		<!-- Google Fonts for Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet" />

		<!-- Slot for page-specific head content (JSON-LD, etc.) -->
		<slot name="head" />
	</head>
	<body class="flex flex-col min-h-screen bg-canvas text-ink antialiased">
		<!-- Top Reading Progress Bar -->
		<div id="reading-progress-bar" class="fixed top-0 left-0 h-[3.5px] bg-primary z-[110] w-0"></div>

		<!-- Spotlight Search Modal -->
		<div id="spotlight-search-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[200] hidden items-start justify-center pt-[10vh] px-4" role="dialog" aria-modal="true">
			<div class="bg-canvas border border-hairline w-full max-w-[640px] rounded-lg shadow-2xl overflow-hidden flex flex-col max-h-[70vh]">
				<!-- Input field -->
				<div class="flex items-center px-4 border-b border-hairline h-[56px] gap-3">
					<svg class="w-5 h-5 text-ink-muted-48 fill-none stroke-current stroke-[2] shrink-0" viewBox="0 0 24 24">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<input 
						type="text" 
						id="spotlight-search-input" 
						name="site-search"
						aria-label="Search guides, transaction codes, and FAQs"
						placeholder="Search guides, transaction codes, and FAQs..." 
						class="w-full bg-transparent border-none text-ink text-[16px] focus:outline-none placeholder-ink-muted-48"
						autocomplete="off"
					/>
					<button id="spotlight-close-btn" class="text-[12px] font-caption-strong text-ink-muted-48 hover:text-ink px-2 py-1 border border-hairline rounded bg-canvas-parchment cursor-pointer shrink-0">
						ESC
					</button>
				</div>
				<!-- Search results list -->
				<div id="spotlight-search-results" class="overflow-y-auto flex-grow p-2 flex flex-col gap-1 empty:hidden">
					<!-- Dynamically populated -->
				</div>
				<div id="spotlight-search-empty" class="hidden flex-col items-center justify-center p-12 text-ink-muted-80 text-[14px]">
					<svg class="w-10 h-10 text-ink-muted-48 fill-none stroke-current stroke-[1.5] mb-3" viewBox="0 0 24 24">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<span>No results found</span>
				</div>
				<!-- Search footer instructions -->
				<div class="px-4 py-2.5 bg-canvas-parchment border-t border-hairline text-[11px] text-ink-muted-48 flex items-center justify-between font-caption shrink-0">
					<div class="flex gap-4">
						<span><kbd class="font-bold border border-hairline bg-canvas px-1 rounded shadow-sm">↑↓</kbd> to navigate</span>
						<span><kbd class="font-bold border border-hairline bg-canvas px-1 rounded shadow-sm">Enter</kbd> to select</span>
					</div>
					<span>Learn SAP Free Search</span>
				</div>
			</div>
		</div>

		<!-- Global Navigation (Thin black bar) -->
		<GlobalNav />

		<!-- Sub Navigation (Frosted parchment bar) -->
		<SubNav />

		<!-- Main Content Slot -->
		<main class="flex-grow">
			<slot />
		</main>

		<!-- Global Rewarded Ad Script (Homepage & All Pages) -->
		<RewardedAdGate />

		<!-- Footer (Parchment high-density links) -->
		<Footer />

		<!-- GDPR Cookie Consent Banner -->
		<CookieConsent />

		<!-- Inject search data window reference -->
		<script define:vars={{ searchIndexData }}>
			window.searchIndex = searchIndexData;
		</script>

		<!-- Core Global Features (Dark Mode, Spotlight, Copy buttons, Progress bar) -->
		<script>
			// 1. Dark Mode setup & listeners
			const setupThemeToggle = () => {
				const toggleBtns = document.querySelectorAll('.theme-toggle-btn');
				
				const handleThemeToggle = () => {
					document.documentElement.classList.add('theme-transition');
					const isDark = document.documentElement.classList.toggle('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
					
					// Update ARIA attributes on all buttons
					toggleBtns.forEach(btn => {
						btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
					});

					setTimeout(() => {
						document.documentElement.classList.remove('theme-transition');
					}, 350);
				};

				toggleBtns.forEach(btn => {
					// Remove old event listener if exists to prevent duplicates
					btn.removeEventListener('click', handleThemeToggle);
					btn.addEventListener('click', handleThemeToggle);
					
					// Set initial accessibility label
					const isCurrentlyDark = document.documentElement.classList.contains('dark');
					btn.setAttribute('aria-label', isCurrentlyDark ? 'Switch to light mode' : 'Switch to dark mode');
				});
			};

			// 2. Reading Progress Bar handler
			const setupProgressBar = () => {
				const bar = document.getElementById('reading-progress-bar');
				if (!bar) return;

				const handleScroll = () => {
					const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
					const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
					if (scrollHeight <= 0) {
						bar.style.width = '0%';
						return;
					}
					const scrolled = (scrollTop / scrollHeight) * 100;
					bar.style.width = `${scrolled}%`;
				};

				window.addEventListener('scroll', handleScroll);
				handleScroll(); // initial state
			};

			// 3. Code Block Copy Buttons
			const setupCopyButtons = () => {
				const preBlocks = document.querySelectorAll('.rich-text pre');
				preBlocks.forEach(pre => {
					// Check if already wrapped
					if (pre.parentElement && pre.parentElement.classList.contains('code-container')) return;

					// Create wrapper
					const container = document.createElement('div');
					container.className = 'code-container my-6';
					
					// Insert wrapper before pre
					pre.parentNode?.insertBefore(container, pre);
					container.appendChild(pre);

					// Create Copy button
					const button = document.createElement('button');
					button.className = 'copy-code-btn';
					button.type = 'button';
					button.textContent = 'Copy';
					container.appendChild(button);

					button.addEventListener('click', () => {
						const codeElement = pre.querySelector('code');
						const textToCopy = codeElement ? codeElement.innerText : pre.innerText;

						navigator.clipboard.writeText(textToCopy).then(() => {
							button.textContent = 'Copied!';
							button.classList.add('text-green-600', 'border-green-600');
							
							setTimeout(() => {
								button.textContent = 'Copy';
								button.classList.remove('text-green-600', 'border-green-600');
							}, 2000);
						}).catch(() => {
							button.textContent = 'Error';
						});
					});
				});
			};

			// 4. Spotlight Search Logic
			const setupSpotlightSearch = () => {
				const modal = document.getElementById('spotlight-search-modal');
				const input = document.getElementById('spotlight-search-input') as HTMLInputElement | null;
				const resultsContainer = document.getElementById('spotlight-search-results');
				const emptyState = document.getElementById('spotlight-search-empty');
				const closeBtn = document.getElementById('spotlight-close-btn');
				const searchTriggers = document.querySelectorAll('.search-trigger-btn');

				if (!modal || !input || !resultsContainer) return;

				let activeIndex = -1;
				let matchedItems: any[] = [];

				const openModal = (e?: Event) => {
					e?.preventDefault();
					modal.classList.remove('hidden');
					modal.classList.add('flex');
					input.value = '';
					resultsContainer.innerHTML = '';
					emptyState?.classList.add('hidden');
					activeIndex = -1;
					matchedItems = [];
					setTimeout(() => input.focus(), 50);
				};

				const closeModal = () => {
					modal.classList.remove('flex');
					modal.classList.add('hidden');
				};

				// Bind trigger events
				searchTriggers.forEach(trigger => {
					trigger.removeEventListener('click', openModal);
					trigger.addEventListener('click', openModal);
				});

				// Close buttons
				closeBtn?.addEventListener('click', closeModal);
				modal.addEventListener('click', (e) => {
					if (e.target === modal) closeModal();
				});

				// Keyboard bindings
				const handleGlobalKeydown = (e: KeyboardEvent) => {
					// Cmd+K or Ctrl+K
					if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
						e.preventDefault();
						if (modal.classList.contains('hidden')) {
							openModal();
						} else {
							closeModal();
						}
					}
					// Escape
					if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
						e.preventDefault();
						closeModal();
					}
				};

				window.removeEventListener('keydown', handleGlobalKeydown);
				window.addEventListener('keydown', handleGlobalKeydown);

				// Perform Fuzzy Filtering
				const performSearch = () => {
					const query = input.value.toLowerCase().trim();
					resultsContainer.innerHTML = '';
					activeIndex = -1;

					if (!query) {
						emptyState?.classList.add('hidden');
						matchedItems = [];
						return;
					}

					const searchIndex = (window as any).searchIndex || [];
					
					// Match search query
					matchedItems = searchIndex.filter((item: any) => {
						return item.title.toLowerCase().includes(query) || 
						       item.desc.toLowerCase().includes(query) ||
						       item.category.toLowerCase().includes(query);
					}).slice(0, 8); // Max 8 results

					if (matchedItems.length === 0) {
						emptyState?.classList.remove('hidden');
						return;
					}

					emptyState?.classList.add('hidden');

					matchedItems.forEach((item, index) => {
						const anchor = document.createElement('a');
						anchor.href = item.url;
						anchor.className = `flex flex-col p-3 rounded-md transition-colors border border-transparent hover:bg-canvas-parchment ${
							index === 0 ? 'bg-canvas-parchment' : ''
						}`;
						anchor.setAttribute('data-search-index', index.toString());

						// Highlight matched parts (basic)
						const badgeColor = item.type === 'Guide' ? 'bg-primary/5 text-primary border-primary/20' : 'bg-amber-500/5 text-amber-600 border-amber-500/20';

						anchor.innerHTML = `
							<div class="flex items-center justify-between mb-1.5">
								<span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded-sm border ${badgeColor}">
									${item.type} &middot; ${item.category}
								</span>
							</div>
							<h4 class="font-body-strong text-[15px] text-ink leading-tight">${item.title}</h4>
							<p class="font-caption text-[13px] text-ink-muted-80 line-clamp-1 mt-0.5">${item.desc}</p>
						`;
						resultsContainer.appendChild(anchor);
					});

					activeIndex = matchedItems.length > 0 ? 0 : -1;
				};

				// Input typing handler
				input.addEventListener('input', performSearch);

				// Navigate and select via keyboard
				const handleNav = (e: KeyboardEvent) => {
					if (modal.classList.contains('hidden') || matchedItems.length === 0) return;

					if (e.key === 'ArrowDown') {
						e.preventDefault();
						activeIndex = (activeIndex + 1) % matchedItems.length;
						updateActiveItem();
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						activeIndex = (activeIndex - 1 + matchedItems.length) % matchedItems.length;
						updateActiveItem();
					} else if (e.key === 'Enter' && activeIndex >= 0) {
						e.preventDefault();
						const activeAnchor = resultsContainer.querySelector(`[data-search-index="${activeIndex}"]`) as HTMLAnchorElement | null;
						if (activeAnchor) activeAnchor.click();
					}
				};

				const updateActiveItem = () => {
					const items = resultsContainer.querySelectorAll('a');
					items.forEach((item, index) => {
						if (index === activeIndex) {
							item.classList.add('bg-canvas-parchment');
							item.scrollIntoView({ block: 'nearest' });
						} else {
							item.classList.remove('bg-canvas-parchment');
						}
					});
				};

				input.addEventListener('keydown', handleNav);
			};

			// 5. Scroll Reveal setup
			const setupReveal = () => {
				const observerOptions = {
					root: null,
					rootMargin: '0px 0px -40px 0px',
					threshold: 0.05
				};

				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('revealed');
							observer.unobserve(entry.target);
						}
					});
				}, observerOptions);

				const revealElements = document.querySelectorAll('.reveal');
				revealElements.forEach(el => observer.observe(el));
			};

			// Bind all events on initial load
			const init = () => {
				setupThemeToggle();
				setupProgressBar();
				setupCopyButtons();
				setupSpotlightSearch();
				setupReveal();
			};

			init();
			document.addEventListener('astro:after-swap', init);
		</script>
	</body>
</html>
