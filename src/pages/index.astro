  <!-- LMS Progress Dashboard Client Script -->
  <script>
    const updateLmsTracker = () => {
      const card = document.getElementById('lms-progress-card');
      const pct = document.getElementById('lms-percentage');
      const count = document.getElementById('lms-completed-count');
      const avg = document.getElementById('lms-average-score');
      const desc = document.getElementById('lms-desc');
      const bookmarksSection = document.getElementById('lms-bookmarks-section');
      const bookmarksList = document.getElementById('lms-bookmarks-list');

      if (!card || !pct || !count || !avg || !desc) return;

      try {
        const data = JSON.parse(localStorage.getItem('sap_quiz_progress') || '{}');
        const keys = Object.keys(data);
        const totalQuizzes = keys.length;

        const bookmarks = JSON.parse(localStorage.getItem('sap_bookmarks') || '{}');
        const bKeys = Object.keys(bookmarks);

        if (totalQuizzes === 0 && bKeys.length === 0) {
          card.classList.add('hidden');
          card.classList.remove('flex');
          return;
        }

        // We have completed quizzes or bookmarks! Show card
        card.classList.remove('hidden');
        card.classList.add('flex');

        let totalScore = 0;
        let totalQuestions = 0;

        keys.forEach(key => {
          totalScore += data[key].score;
          totalQuestions += data[key].total;
        });

        const avgPercent = totalQuestions > 0 ? Math.round((totalScore / totalQuestions) * 100) : 0;

        // Custom gamified learning badges
        let badgeName = "SAP Novice";
        if (totalQuizzes >= 8) badgeName = "SAP Architect";
        else if (totalQuizzes >= 5) badgeName = "SAP Consultant";
        else if (totalQuizzes >= 3) badgeName = "ABAP Professional";
        else if (totalQuizzes >= 1) badgeName = "SAP Developer";

        count.textContent = totalQuizzes.toString();
        avg.textContent = `${avgPercent}%`;
        pct.textContent = `${avgPercent}%`;
        desc.textContent = `Current Badge: ${badgeName}. Keep leveling up!`;

        // Style borders based on stats
        if (avgPercent >= 90) {
          pct.classList.add('border-green-500', 'text-green-500');
          pct.classList.remove('border-primary-on-dark', 'text-primary-on-dark');
        } else {
          pct.classList.remove('border-green-500', 'text-green-500');
          pct.classList.add('border-primary-on-dark', 'text-primary-on-dark');
        }

        // Render bookmarks list
        if (bookmarksSection && bookmarksList) {
          if (bKeys.length > 0) {
            bookmarksSection.classList.remove('hidden');
            bookmarksSection.classList.add('flex');
            bookmarksList.innerHTML = bKeys.map(key => {
              const b = bookmarks[key];
              const isTCode = key.startsWith('tcode-');
              const isLine = key.startsWith('line-');
              
              let label = 'Guide';
              let badgeColor = 'bg-primary/10 text-primary-on-dark border-primary/20';

              if (isTCode) {
                label = 'T-Code';
                badgeColor = 'bg-amber-500/10 text-amber-500 border-amber-500/25';
              } else if (isLine) {
                label = 'Snippet';
                badgeColor = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/25';
              }

              return `
                <a href="${b.url}" class="flex flex-col p-3 rounded-md bg-white/5 border border-white/10 hover:border-primary-on-dark hover:bg-white/10 transition-all group">
                  <span class="text-[9px] uppercase font-bold tracking-wider border max-w-fit px-1.5 py-0.5 rounded-sm ${badgeColor} mb-1.5">${label} &middot; ${b.category}</span>
                  <span class="font-body-strong text-[14px] text-white line-clamp-1 leading-tight group-hover:text-primary-on-dark transition-colors">${b.title}</span>
                </a>
              `;
            }).join('');
          } else {
            bookmarksSection.classList.add('hidden');
            bookmarksSection.classList.remove('flex');
            bookmarksList.innerHTML = '';
          }
        }

      } catch (e) {
        console.error("LMS tracker load error: ", e);
      }
    };

    // Run on initial load
    updateLmsTracker();

    // Listen to quiz completions and bookmarks updates
    window.addEventListener('sap-quiz-updated', updateLmsTracker);
    window.addEventListener('sap-bookmarks-updated', updateLmsTracker);
    document.addEventListener('astro:after-swap', updateLmsTracker);

    // Mobile Tabs Navigation Switching Logic
    const setupMobileTabs = () => {
      const isMobile = window.innerWidth < 768; // md breakpoint is 768px
      const tabButtons = document.querySelectorAll('[data-tab]');
      const sectionChallenge = document.getElementById('challenge');
      const sectionTCodes = document.getElementById('tcode-dictionary');
      const sectionTips = document.getElementById('tips');

      if (!sectionChallenge || !sectionTCodes || !sectionTips) return;

      if (!isMobile) {
        // Desktop: make all sections visible
        sectionChallenge.classList.remove('hidden');
        sectionTCodes.classList.remove('hidden');
        sectionTips.classList.remove('hidden');
        return;
      }

      // Mobile active switching logic
      const switchTab = (tabId: string) => {
        // Hide all
        sectionChallenge.classList.add('hidden');
        sectionTCodes.classList.add('hidden');
        sectionTips.classList.add('hidden');

        // Unhide selected
        const activeSection = document.getElementById(tabId);
        if (activeSection) {
          activeSection.classList.remove('hidden');
        }

        // Toggle active styling on tab buttons
        tabButtons.forEach(btn => {
          const b = btn as HTMLButtonElement;
          const target = b.getAttribute('data-tab');
          if (target === tabId) {
            b.classList.add('bg-canvas', 'text-primary', 'font-semibold', 'shadow-sm');
            b.classList.remove('bg-transparent', 'text-ink-muted-80');
          } else {
            b.classList.remove('bg-canvas', 'text-primary', 'font-semibold', 'shadow-sm');
            b.classList.add('bg-transparent', 'text-ink-muted-80');
          }
        });
      };

      // Register click triggers
      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetTab = btn.getAttribute('data-tab') || "challenge";
          switchTab(targetTab);
          
          // Smooth scroll to the top of the tabs bar to align view
          const tabsBar = document.querySelector('[data-tab]')?.parentElement?.parentElement;
          if (tabsBar) {
            tabsBar.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // Default load state: show challenge (Daily tip/quiz)
      switchTab('challenge');
    };

    // Run tab initialization
    setupMobileTabs();
    window.addEventListener('resize', setupMobileTabs);
    document.addEventListener('astro:after-swap', setupMobileTabs);
  </script>
