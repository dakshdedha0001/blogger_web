---
// src/pages/blog/index.astro
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

// Fetch all posts and sort by learning order ascending
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  if (orderA !== orderB) {
    return orderA - orderB;
  }
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

// Fetch all posts to extract complete list of unique categories
const categories = ['All', ...new Set(sortedPosts.map(p => p.data.category))];

// Helper for category classes (colored subtle borders)
const getCategoryStyles = (category: string) => {
  switch (category.toUpperCase()) {
    case 'ABAP PROGRAMMING': return 'border-l-4 border-primary';
    case 'DATA DICTIONARY': return 'border-l-4 border-indigo-500';
    case 'SAP FIORI': return 'border-l-4 border-emerald-500';
    case 'SAP BTP': return 'border-l-4 border-amber-500';
    default: return 'border-l-4 border-purple-500';
  }
};

const getCategoryBadgeStyles = (category: string) => {
  switch (category.toUpperCase()) {
    case 'ABAP PROGRAMMING': return 'bg-primary/5 text-primary border-primary/20';
    case 'DATA DICTIONARY': return 'bg-indigo-500/5 text-indigo-600 border-indigo-500/20';
    case 'SAP FIORI': return 'bg-emerald-500/5 text-emerald-600 border-emerald-500/20';
    case 'SAP BTP': return 'bg-amber-500/5 text-amber-600 border-amber-500/20';
    default: return 'bg-purple-500/5 text-purple-600 border-purple-500/20';
  }
};

// JSON-LD: CollectionPage with ItemList
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "SAP Training Blog - Learn SAP Free",
  "description": "Browse tutorials and guides covering ABAP coding, SAP Fiori UX design, HANA SQL scripts, BTP cloud development, and Basis monitoring.",
  "url": "https://learnsapfree.com/blog",
  "mainEntity": {
    "@type": "ItemList",
    "name": "SAP Training Tutorials",
    "numberOfItems": sortedPosts.length,
    "itemListElement": sortedPosts.map((post, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": post.data.title,
      "url": `https://learnsapfree.com/blog/${post.id}`
    }))
  }
};

// JSON-LD: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://learnsapfree.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://learnsapfree.com/blog"
    }
  ]
};
---

<Layout 
  title="SAP Training Blog - Free ABAP, Fiori, HANA, BTP Tutorials | Learn SAP Free" 
  description="Browse our complete library of free SAP tutorials covering ABAP programming, SAP Fiori UX development, HANA database, BTP cloud platform, Data Dictionary, and career guides for SAP professionals."
  keywords={[
    "sap training blog", "sap abap tutorials", "sap fiori tutorials", "sap hana guides",
    "sap btp tutorials", "learn sap abap", "sap programming blog", "sap developer tutorials",
    "sap data dictionary", "sap career guide", "free sap training", "sap online tutorials"
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <section class="bg-canvas py-[64px] min-h-[75vh] ">
    <div class="max-w-[1024px] mx-auto px-4 md:px-[24px]">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-1.5 font-caption text-[13px] text-ink-muted-48">
          <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
          <li><span class="mx-1">›</span></li>
          <li class="text-ink font-semibold">Blog</li>
        </ol>
      </nav>

      <!-- Page Header -->
      <header class="text-center mb-12">
        <span class="text-primary font-caption-strong text-[14px] uppercase tracking-wider mb-2 block">SAP Learning Academy</span>
        <h1 class="font-display-lg text-[32px] md:text-[40px] tracking-tight leading-none mb-3">Training Guides</h1>
        <p class="font-body-apple text-[16px] text-ink-muted-80 max-w-[600px] mx-auto mb-6">
          Explore theoretical principles and step-by-step practical guides compiled by SAP experts.
        </p>
      </header>

      <!-- Category Description / Tracks Explanation Card -->
      <div 
        id="category-description-card"
        class="bg-canvas-parchment rounded-lg border border-hairline p-5 mb-8 text-left transition-all duration-300"
      >
        <h4 id="category-desc-title" class="font-body-strong text-[17px] text-ink mb-2">
          SAP ABAP & Fiori Learning Path
        </h4>
        <p id="category-desc-text" class="font-caption text-[14px] text-ink-muted-80 leading-relaxed">
          Master the fundamentals of SAP development. Our academy guides are categorized into four core tracks: ABAP Programming (logic and applications), Data Dictionary (table and structure modeling), SAP Careers (industry roadmaps), and SAP Fiori (modern user experience and web development). Select a category below to narrow down your study.
        </p>
      </div>
 
      <!-- Search and Filter Bar -->
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 border-b border-hairline pb-8 mb-8">
        <!-- Search -->
        <div class="relative w-full md:max-w-[340px]">
          <label for="blog-search-input" class="sr-only">Search training guides</label>
          <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-ink-muted-48">
            <svg class="w-4 h-4 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <input 
            type="text" 
            id="blog-search-input"
            name="blog-search"
            aria-label="Search training guides"
            autocomplete="off"
            spellcheck="false"
            placeholder="Search guides by keyword..." 
            class="w-full h-[40px] pl-10 pr-4 rounded-full border border-hairline focus:outline-none focus:border-primary font-body-apple text-[14px] bg-canvas text-ink"
          />
        </div>

        <!-- Filter Chips -->
        <div class="flex flex-wrap items-center gap-1.5 justify-center">
          {categories.map(cat => (
            <button 
              class="blog-filter-chip" 
              class:list={[{ 'active-chip': cat === 'All' }]} 
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Articles Grid -->
      <div 
        id="blog-articles-grid" 
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]"
      >
        {sortedPosts.map(post => (
          <article 
            class={`store-utility-card flex flex-col justify-between h-[450px] group cursor-pointer relative reveal ${getCategoryStyles(post.data.category)}`}
            data-title={post.data.title.toLowerCase()}
            data-desc={post.data.description.toLowerCase()}
            data-category={post.data.category}
          >
            <div>
              <!-- Thumbnail Image -->
              {post.data.image && (
                <div class="w-full h-[140px] overflow-hidden rounded-sm mb-4 border border-hairline/35 bg-canvas-parchment relative">
                  <Image 
                    src={post.data.image} 
                    alt={post.data.title}
                    width={400}
                    height={140}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>
              )}
              
              <!-- Category and Date -->
              <div class="flex items-center justify-between mb-3">
                <span class={`text-[10px] uppercase font-bold tracking-wider px-[8px] py-[3px] rounded-sm border ${getCategoryBadgeStyles(post.data.category)}`}>
                  {post.data.category}
                </span>
                <span class="font-fine-print text-ink-muted-48 text-[11px]">
                  {post.data.readingTime || '5 min read'}
                </span>
              </div>

              <!-- Title -->
              <h3 class="font-body-strong text-[17px] text-ink line-clamp-2 mb-2 leading-snug group-hover:text-primary transition-colors">
                {post.data.title}
              </h3>
              
              <!-- Description -->
              <p class="font-caption text-[14px] text-ink-muted-80 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <!-- Footer Link -->
            <div class="pt-4 border-t border-hairline flex items-center justify-between">
              <span class="font-fine-print text-ink-muted-48">By {post.data.author}</span>
              <a href={`/blog/${post.id}`} class="text-link font-caption-strong text-[14px] inline-flex items-center gap-1 hover:gap-2 transition-all after:absolute after:inset-0 after:z-10">
                Read Guide 
                <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State -->
      <div id="blog-empty-state" class="hidden text-center py-[80px] text-ink-muted-80 font-body-apple">
        <svg class="w-12 h-12 stroke-current fill-none stroke-[1.5] mx-auto mb-4 text-ink-muted-48" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="15" y1="9" x2="9" y2="15"></line>
          <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
        <p class="text-[18px] font-semibold mb-1">No articles match your search</p>
        <p class="text-[14px]">Try typing a different keyword or choosing a different training category.</p>
      </div>

      <!-- Pagination Navigation Controls (Client-Side Controlled) -->
      <nav id="blog-pagination" class="flex flex-col sm:flex-row items-center justify-between border-t border-hairline pt-6 mt-12 gap-4 font-button-utility" aria-label="Pagination">
        <div>
          <p class="text-[14px] text-ink-muted-80 font-caption">
            Showing <span id="entries-start" class="font-semibold">1</span> to <span id="entries-end" class="font-semibold">6</span> of <span id="entries-total" class="font-semibold">11</span> entries
          </p>
        </div>
        <div class="flex items-center gap-[16px]">
          <button id="prev-btn" class="text-link font-caption-strong flex items-center gap-1.5 hover:text-primary-focus transition-colors bg-transparent border-none cursor-pointer">
            <svg class="w-4 h-4 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Previous
          </button>
          
          <div id="page-numbers" class="flex items-center gap-[6px]">
            <!-- Injected by JavaScript -->
          </div>

          <button id="next-btn" class="text-link font-caption-strong flex items-center gap-1.5 hover:text-primary-focus transition-colors bg-transparent border-none cursor-pointer">
            Next
            <svg class="w-4 h-4 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </nav>

    </div>
  </section>
</Layout>

<style>
  .blog-filter-chip {
    background-color: var(--color-canvas);
    color: var(--color-ink);
    font-family: var(--font-text);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.0;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    padding: 8px 14px;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
  }
  .blog-filter-chip:hover {
    border-color: var(--color-ink-muted-48);
  }
  .blog-filter-chip.active-chip {
    background-color: var(--color-ink);
    color: var(--color-canvas) !important;
    border-color: var(--color-ink);
  }
</style>

<script>
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
  const filterChips = document.querySelectorAll('.blog-filter-chip');
  const articles = document.querySelectorAll('#blog-articles-grid article');
  const emptyState = document.getElementById('blog-empty-state');

  // Pagination elements
  const paginationNav = document.getElementById('blog-pagination');
  const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('next-btn') as HTMLButtonElement | null;
  const pageNumbersContainer = document.getElementById('page-numbers');
  const entriesStart = document.getElementById('entries-start');
  const entriesEnd = document.getElementById('entries-end');
  const entriesTotal = document.getElementById('entries-total');

  let currentSearch = "";
  let currentCategory = "All";
  let currentPage = 1;
  const pageSize = 6;

  const categoryDescTitle = document.getElementById('category-desc-title');
  const categoryDescText = document.getElementById('category-desc-text');

  const descMap: Record<string, { title: string; text: string }> = {
    "All": {
      title: "SAP ABAP & Fiori Learning Path",
      text: "Master the fundamentals of SAP development. Our academy guides are categorized into five core tracks: ABAP Programming (logic and applications), Data Dictionary (table and structure modeling), SAP Careers (industry roadmaps), SAP Fiori (modern user experience), and SAP BTP (cloud platform integration and development). Select a category below to narrow down your study."
    },
    "ABAP Programming": {
      title: "ABAP Programming Track",
      text: "Learn the core programming structures of SAP's proprietary language. This track covers basic syntax, variable declarations using the DATA statement, dynamic inputs with the PARAMETERS statement, conditional decision-making using IF/ELSE blocks, and modular code development."
    },
    "Data Dictionary": {
      title: "ABAP Data Dictionary (SE11) Track",
      text: "Understand the database backend and data modeling capabilities of SAP systems. This track focuses on using transaction SE11 to define transparent tables, structures, reusable data elements, domain value sets, and automated interfaces like the Table Maintenance Generator (TMG)."
    },
    "SAP Careers": {
      title: "SAP Career Guides & Roadmaps",
      text: "Explore career opportunities, salary trends, certification paths, and roadmap strategies for freshers entering the SAP ecosystem. Learn about technical and functional roles across different business modules."
    },
    "SAP Fiori": {
      title: "SAP Fiori & UI5 Development Track",
      text: "Master modern user experiences in SAP. This track covers HTML5, CSS3, JavaScript, SAPUI5 framework MVC architecture, OData integration, Fiori Launchpad customization, and SAP Fiori design guidelines."
    },
    "SAP BTP": {
      title: "SAP BTP (Business Technology Platform) Track",
      text: "Explore SAP BTP, the cloud foundation for modern enterprise architectures. Learn about database and data management, analytics, application development, process automation, and integration suite capabilities."
    }
  };

  function updateUI() {
    // 1. Filter articles matching category & search query
    const matchedArticles: HTMLElement[] = [];
    articles.forEach(el => {
      const art = el as HTMLElement;
      const title = art.getAttribute('data-title') || "";
      const desc = art.getAttribute('data-desc') || "";
      const category = art.getAttribute('data-category') || "";

      const matchSearch = title.includes(currentSearch) || desc.includes(currentSearch);
      const matchCategory = currentCategory === "All" || category === currentCategory;

      if (matchSearch && matchCategory) {
        matchedArticles.push(art);
      } else {
        art.style.display = 'none';
      }
    });

    const totalMatched = matchedArticles.length;

    // 2. Handle empty state
    if (totalMatched === 0) {
      emptyState?.classList.remove('hidden');
      if (paginationNav) paginationNav.style.display = 'none';
      return;
    } else {
      emptyState?.classList.add('hidden');
    }

    // 3. Paginate the matched articles
    const totalPages = Math.ceil(totalMatched / pageSize);
    
    // Clamp page
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIndex = (currentPage - 1) * pageSize;
    const endIndex = Math.min(startIndex + pageSize, totalMatched);

    // Show only articles on current page, hide others
    matchedArticles.forEach((art, index) => {
      if (index >= startIndex && index < endIndex) {
        art.style.display = '';
      } else {
        art.style.display = 'none';
      }
    });

    // 4. Update pagination controls
    if (totalPages <= 1) {
      if (paginationNav) paginationNav.style.display = 'none';
    } else {
      if (paginationNav) paginationNav.style.display = 'flex';
      
      if (entriesStart) entriesStart.textContent = (startIndex + 1).toString();
      if (entriesEnd) entriesEnd.textContent = endIndex.toString();
      if (entriesTotal) entriesTotal.textContent = totalMatched.toString();

      // Render direct page numbers
      if (pageNumbersContainer) {
        pageNumbersContainer.innerHTML = "";
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.textContent = i.toString();
          btn.className = `w-[32px] h-[32px] rounded-sm text-[13px] font-semibold flex items-center justify-center cursor-pointer transition-all border outline-none ${
            i === currentPage
              ? 'bg-primary text-white border-primary active-scale'
              : 'bg-transparent border-hairline text-ink hover:border-ink-muted-48 hover:bg-canvas-parchment'
          }`;
          btn.addEventListener('click', () => {
            currentPage = i;
            updateUI();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
          pageNumbersContainer.appendChild(btn);
        }
      }

      // Prev button disabled state
      if (prevBtn) {
        if (currentPage === 1) {
          prevBtn.classList.add('opacity-40', 'cursor-not-allowed');
          prevBtn.disabled = true;
        } else {
          prevBtn.classList.remove('opacity-40', 'cursor-not-allowed');
          prevBtn.disabled = false;
        }
      }

      // Next button disabled state
      if (nextBtn) {
        if (currentPage === totalPages) {
          nextBtn.classList.add('opacity-40', 'cursor-not-allowed');
          nextBtn.disabled = true;
        } else {
          nextBtn.classList.remove('opacity-40', 'cursor-not-allowed');
          nextBtn.disabled = false;
        }
      }
    }
  }

  // Search handler
  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value.toLowerCase();
    currentPage = 1; // Reset to page 1 on search
    updateUI();
  });

  // Category filter handler
  filterChips.forEach(chip => {
    chip.addEventListener('click', () => {
      filterChips.forEach(c => c.classList.remove('active-chip'));
      chip.classList.add('active-chip');
      currentCategory = chip.getAttribute('data-category') || "All";
      currentPage = 1; // Reset to page 1 on category change
      
      // Update description text dynamically
      if (categoryDescTitle && categoryDescText) {
        const info = descMap[currentCategory] || descMap["All"];
        categoryDescTitle.textContent = info.title;
        categoryDescText.textContent = info.text;
      }

      updateUI();
    });
  });

  // Pagination click handlers
  prevBtn?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      updateUI();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
  nextBtn?.addEventListener('click', () => {
    currentPage++;
    updateUI();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Initial run
  const urlParams = new URLSearchParams(window.location.search);
  const catParam = urlParams.get('category');
  if (catParam && descMap[catParam]) {
    currentCategory = catParam;
    filterChips.forEach(c => {
      if (c.getAttribute('data-category') === catParam) {
        c.classList.add('active-chip');
      } else {
        c.classList.remove('active-chip');
      }
    });
    // Update description text dynamically
    if (categoryDescTitle && categoryDescText) {
      const info = descMap[currentCategory] || descMap["All"];
      categoryDescTitle.textContent = info.title;
      categoryDescText.textContent = info.text;
    }
  }
  updateUI();
</script>
