---
import Layout from "../layouts/Layout.astro";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Learn SAP Free",
  "description": "Get in touch with the Learn SAP Free team for questions, feedback, or collaboration on SAP ABAP, Fiori, HANA, and BTP tutorials.",
  "url": "https://learnsapfree.com/contact",
  "mainEntity": {
    "@type": "Organization",
    "name": "Learn SAP Free",
    "url": "https://learnsapfree.com",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "url": "https://learnsapfree.com/contact",
      "availableLanguage": "English"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://learnsapfree.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact Us",
      "item": "https://learnsapfree.com/contact"
    }
  ]
};
---

<Layout
  title="Contact Us - Learn SAP Free | SAP Training Support"
  description="Have questions about SAP ABAP, Fiori, HANA, or BTP tutorials? Contact the Learn SAP Free team for feedback, suggestions, or collaboration opportunities."
  keywords={["contact learn sap free", "sap training support", "sap abap help", "sap fiori questions", "sap learning community"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <section class="bg-canvas py-[80px] min-h-[60vh]">
    <div class="max-w-[720px] mx-auto px-4">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-1.5 font-caption text-[13px] text-ink-muted-48">
          <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
          <li><span class="mx-1">›</span></li>
          <li class="text-ink font-semibold">Contact Us</li>
        </ol>
      </nav>

      <!-- Back Link -->
      <a
        href="/"
        class="text-link font-caption-strong text-[14px] inline-flex items-center gap-1 mb-8 hover:text-primary-focus transition-colors"
      >
        <svg
          class="w-4 h-4 stroke-current fill-none stroke-[2]"
          viewBox="0 0 24 24"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Dashboard
      </a>

      <!-- Page Header -->
      <header class="border-b border-hairline pb-6 mb-8">
        <span
          class="text-primary font-caption-strong text-[13px] uppercase tracking-wider block mb-2"
          >Get In Touch</span
        >
        <h1
          class="font-display-lg text-[32px] md:text-[40px] text-ink leading-tight tracking-tight"
        >
          Contact Us
        </h1>
        <p class="font-caption text-[14px] text-ink-muted-80 mt-2 leading-relaxed max-w-[560px]">
          We'd love to hear from you. Whether you have questions about our SAP tutorials, suggestions for new content, or feedback on existing guides — send us a message below.
        </p>
      </header>

      <!-- Content -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <!-- Details Card -->
        <div
          class="bg-canvas-parchment rounded-lg border border-hairline p-8 flex flex-col gap-4"
        >
          <h3 class="font-body-strong text-[17px] text-ink">
            Feedback & Suggestions
          </h3>
          <p class="font-caption text-[14px] text-ink-muted-80 leading-relaxed">
            If you have any questions, feedback, or suggestions related to our
            SAP training guides, tutorials, or learning tools, feel free to reach out using the contact form. We
            will try our best to respond as early as possible.
          </p>
          <div class="h-[1px] bg-hairline my-2"></div>
          <div class="flex flex-col gap-3">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary fill-none stroke-current stroke-[2] mt-0.5 shrink-0" viewBox="0 0 24 24">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
              <div>
                <span class="font-caption-strong text-[12px] text-ink-muted-48 uppercase tracking-wider block mb-0.5">Response Time</span>
                <span class="font-caption text-[14px] text-ink-muted-80">We typically respond within 24–48 hours</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary fill-none stroke-current stroke-[2] mt-0.5 shrink-0" viewBox="0 0 24 24">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <div>
                <span class="font-caption-strong text-[12px] text-ink-muted-48 uppercase tracking-wider block mb-0.5">Email Support</span>
                <a href="mailto:support@learnsapfree.com" class="font-caption text-[14px] text-primary hover:underline">support@learnsapfree.com</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary fill-none stroke-current stroke-[2] mt-0.5 shrink-0" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M2 12h20"></path>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <div>
                <span class="font-caption-strong text-[12px] text-ink-muted-48 uppercase tracking-wider block mb-0.5">Topics</span>
                <span class="font-caption text-[14px] text-ink-muted-80">SAP ABAP, Fiori, HANA, BTP, Careers & more</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Widget (Sleek Apple style) -->
        <form
          id="contact-form"
          class="flex flex-col gap-4"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <!-- Web3Forms Access Key (public, safe to expose) -->
          <input
            type="hidden"
            name="access_key"
            value="3820ea36-76b9-4b47-a922-ce3f669bac3d"
          />
          <!-- Honeypot spam protection -->
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
          />
          <input
            type="hidden"
            name="subject"
            value="New Contact Form Submission — Learn SAP Free"
          />
          <input
            type="hidden"
            name="from_name"
            value="Learn SAP Free Contact Form"
          />

          <div>
            <label
              for="contact-name"
              class="block font-caption-strong text-[12px] text-ink-muted-80 mb-1"
              >Your Name</label
            >
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              class="w-full h-[40px] px-3 border border-hairline rounded-sm focus:outline-none focus:border-primary bg-canvas text-ink font-body-apple text-[14px]"
            />
          </div>
          <div>
            <label
              for="contact-email"
              class="block font-caption-strong text-[12px] text-ink-muted-80 mb-1"
              >Email Address</label
            >
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              class="w-full h-[40px] px-3 border border-hairline rounded-sm focus:outline-none focus:border-primary bg-canvas text-ink font-body-apple text-[14px]"
            />
          </div>
          <div>
            <label
              for="contact-message"
              class="block font-caption-strong text-[12px] text-ink-muted-80 mb-1"
              >Message</label
            >
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              class="w-full p-3 border border-hairline rounded-sm focus:outline-none focus:border-primary bg-canvas text-ink font-body-apple text-[14px] resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            id="contact-submit-btn"
            class="button-primary h-[40px] font-semibold text-[14px]"
          >
            Send Message
          </button>

          <div
            id="contact-success"
            class="hidden text-green-600 font-body-apple text-[14px] text-center mt-2"
          >
            ✓ Message sent successfully! We will get back to you soon.
          </div>
          <div
            id="contact-error"
            class="hidden text-red-600 font-body-apple text-[14px] text-center mt-2"
          >
            ✗ Something went wrong. Please try again later or use the contact form once more.
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const success = document.getElementById("contact-success");
  const error = document.getElementById("contact-error");
  const submitBtn = document.getElementById("contact-submit-btn");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Hide previous messages
    success?.classList.add("hidden");
    error?.classList.add("hidden");

    // Show loading state
    if (submitBtn) {
      submitBtn.textContent = "Sending...";
      (submitBtn as HTMLButtonElement).disabled = true;
    }

    try {
      const formData = new FormData(form);
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
      });

      const result = await response.json();

      if (result.success) {
        success?.classList.remove("hidden");
        form.reset();
      } else {
        error?.classList.remove("hidden");
      }
    } catch {
      error?.classList.remove("hidden");
    } finally {
      if (submitBtn) {
        submitBtn.textContent = "Send Message";
        (submitBtn as HTMLButtonElement).disabled = false;
      }
      setTimeout(() => {
        success?.classList.add("hidden");
        error?.classList.add("hidden");
      }, 5000);
    }
  });
</script>

