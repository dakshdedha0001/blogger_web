---
// src/components/Quiz.astro
import { quizzes } from '../data/quizzes';

interface Props {
  slug?: string;
}

const { slug } = Astro.props;

// Get the correct quiz questions based on the slug, or fall back to a default set
const questions = slug && quizzes[slug] ? quizzes[slug] : quizzes["first-abap-program-beginners-guide"];
---

<div 
  id="quiz-container" 
  data-questions={JSON.stringify(questions)}
  data-slug={slug || "homepage"}
  class="relative bg-surface-tile-2 rounded-lg border border-white/10 p-6 md:p-8 text-body-on-dark shadow-product flex flex-col justify-between min-h-[400px] md:h-[400px] h-auto"
>
  <!-- Quiz Active Screen -->
  <div id="quiz-active-screen" class="flex flex-col h-full justify-between">
    <div>
      <!-- Progress Indicator -->
      <div class="flex items-center justify-between mb-4">
        <span class="text-[10px] uppercase font-bold tracking-wider px-[8px] py-[3px] rounded-sm bg-white/10 text-body-muted border border-white/5">
          SAP Challenge
        </span>
        <span id="quiz-progress" class="font-mono text-[12px] text-body-muted">Question 1 of 10</span>
      </div>

      <!-- Question Title -->
      <h3 id="quiz-question-title" class="font-display-lg text-[16px] md:text-[18px] tracking-tight leading-snug mb-4">
        Loading question...
      </h3>

      <!-- Answer Options List -->
      <div id="quiz-options-list" class="flex flex-col gap-2">
        <!-- Generated by JS -->
      </div>
    </div>

    <!-- Feedback / Footer Row -->
    <div id="quiz-feedback-row" class="min-h-[44px] flex items-center justify-between border-t border-white/10 pt-4 mt-4">
      <p id="quiz-explanation" class="text-[12px] text-body-muted font-caption max-w-[75%] leading-normal"></p>
      <button 
        id="quiz-next-btn"
        class="hidden bg-primary text-body-on-dark font-body-apple text-[13px] px-[16px] py-[6px] rounded-full hover:bg-primary-focus transition-all duration-150 cursor-pointer active:scale-95"
      >
        Next
      </button>
    </div>
  </div>

  <!-- Quiz Completed Screen -->
  <div id="quiz-result-screen" class="hidden flex-col items-center justify-center text-center h-full gap-4">
    <div class="w-[56px] h-[56px] bg-white/5 rounded-full flex items-center justify-center border border-white/10">
      <svg class="w-6 h-6 text-primary-on-dark fill-none stroke-current stroke-[2]" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
    </div>

    <div>
      <h3 class="font-display-lg text-[22px] tracking-tight mb-2">Quiz Completed</h3>
      <p id="quiz-score-summary" class="font-body-apple text-[15px] text-body-muted mb-4"></p>
    </div>

    <button 
      id="quiz-restart-btn"
      class="button-primary bg-primary-on-dark text-surface-black font-semibold text-[14px] px-[20px] py-[8px] hover:bg-white active:scale-95 transition-colors cursor-pointer"
    >
      Retake Challenge
    </button>
  </div>
</div>

<style>
  /* Option Button Style */
  :global(.quiz-option-btn) {
    background-color: rgba(255, 255, 255, 0.04);
    color: var(--color-body-on-dark);
    font-family: var(--font-text);
    font-size: 13px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    text-align: left;
    width: 100%;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
  }
  :global(.quiz-option-btn:hover:not(:disabled)) {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }
  :global(.quiz-option-btn:disabled) {
    cursor: default;
  }
  :global(.quiz-option-btn.correct-choice) {
    background-color: rgba(34, 197, 94, 0.15);
    border-color: rgb(34, 197, 94);
    color: rgb(74, 222, 128);
  }
  :global(.quiz-option-btn.incorrect-choice) {
    background-color: rgba(239, 68, 68, 0.15);
    border-color: rgb(239, 68, 68);
    color: rgb(248, 113, 113);
  }
</style>

<script>
  interface Question {
    q: string;
    options: string[];
    correct: number;
    exp: string;
  }

  const container = document.getElementById('quiz-container');
  const QUESTIONS: Question[] = container ? JSON.parse(container.getAttribute('data-questions') || '[]') : [];

  let currentQuestion = 0;
  let score = 0;
  let answered = false;

  const activeScreen = document.getElementById('quiz-active-screen');
  const resultScreen = document.getElementById('quiz-result-screen');
  const progressText = document.getElementById('quiz-progress');
  const qTitle = document.getElementById('quiz-question-title');
  const optionsList = document.getElementById('quiz-options-list');
  const explanationText = document.getElementById('quiz-explanation');
  const nextBtn = document.getElementById('quiz-next-btn');
  const scoreSummary = document.getElementById('quiz-score-summary');
  const restartBtn = document.getElementById('quiz-restart-btn');

  function loadQuestion() {
    if (QUESTIONS.length === 0) return;

    if (currentQuestion >= QUESTIONS.length) {
      showResults();
      return;
    }

    answered = false;
    const qData = QUESTIONS[currentQuestion];

    if (progressText) progressText.textContent = `Question ${currentQuestion + 1} of ${QUESTIONS.length}`;
    if (qTitle) qTitle.textContent = qData.q;
    if (explanationText) explanationText.textContent = "";
    nextBtn?.classList.add('hidden');

    if (optionsList) {
      optionsList.innerHTML = qData.options.map((opt, idx) => `
        <button class="quiz-option-btn" data-index="${idx}">${opt}</button>
      `).join('');

      const buttons = optionsList.querySelectorAll('.quiz-option-btn');
      buttons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const selectedIdx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || "0");
          handleAnswer(selectedIdx, buttons);
        });
      });
    }
  }

  function handleAnswer(selectedIdx: number, buttons: NodeListOf<Element>) {
    if (answered) return;
    answered = true;

    const qData = QUESTIONS[currentQuestion];
    const isCorrect = selectedIdx === qData.correct;

    if (isCorrect) {
      score++;
    }

    buttons.forEach((btn, idx) => {
      const b = btn as HTMLButtonElement;
      b.disabled = true;
      if (idx === qData.correct) {
        b.classList.add('correct-choice');
      } else if (idx === selectedIdx) {
        b.classList.add('incorrect-choice');
      }
    });

    if (explanationText) explanationText.textContent = qData.exp;
    nextBtn?.classList.remove('hidden');
  }

  function showResults() {
    activeScreen?.classList.add('hidden');
    resultScreen?.classList.remove('hidden');

    if (scoreSummary) {
      scoreSummary.textContent = `You scored ${score} out of ${QUESTIONS.length} correct. Level up your SAP skills daily!`;
    }

    // Save completion state to localStorage
    const quizId = container?.getAttribute('data-slug') || "homepage";
    try {
      const quizProgress = JSON.parse(localStorage.getItem('sap_quiz_progress') || '{}');
      quizProgress[quizId] = {
        score,
        total: QUESTIONS.length,
        completedAt: new Date().toISOString()
      };
      localStorage.setItem('sap_quiz_progress', JSON.stringify(quizProgress));

      // Notify other components (like index progress dashboard)
      window.dispatchEvent(new Event('sap-quiz-updated'));
    } catch (e) {
      console.error(e);
    }
  }

  nextBtn?.addEventListener('click', () => {
    currentQuestion++;
    loadQuestion();
  });

  restartBtn?.addEventListener('click', () => {
    currentQuestion = 0;
    score = 0;
    resultScreen?.classList.add('hidden');
    activeScreen?.classList.remove('hidden');
    loadQuestion();
  });

  // Initial load
  loadQuestion();
</script>
