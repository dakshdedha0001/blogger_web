---
// src/components/admin/ArticleEditor.astro
---

<div id="article-editor-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
  <div class="bg-white dark:bg-[#1c1c1e] w-full max-w-4xl rounded-3xl border border-hairline dark:border-neutral-800 shadow-2xl overflow-hidden max-h-[90vh] flex flex-col my-8">
    
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-hairline dark:border-neutral-800 flex items-center justify-between bg-surface-pearl dark:bg-[#252527]">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-[#0066cc] text-white flex items-center justify-center font-bold text-sm">
          ✍️
        </div>
        <div>
          <h2 class="text-lg font-bold text-ink dark:text-white" id="editor-modal-title">Create & Publish Blog Article</h2>
          <p class="text-xs text-ink-muted-48 dark:text-neutral-400">Write articles, upload images, preview live content, and save as draft or publish.</p>
        </div>
      </div>

      <button id="close-editor-modal-btn" type="button" class="w-8 h-8 rounded-full bg-neutral-200 dark:bg-neutral-800 text-ink dark:text-white flex items-center justify-center hover:bg-neutral-300 dark:hover:bg-neutral-700 transition-colors cursor-pointer">
        ✕
      </button>
    </div>

    <!-- Modal Form Body -->
    <div class="p-6 overflow-y-auto space-y-6 flex-1 text-xs">
      
      <!-- Article Metadata Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-ink dark:text-neutral-200 mb-1">Article Title *</label>
          <input type="text" id="edit-post-title" required placeholder="e.g. Master SAP ABAP Field Symbols in 2026" class="w-full bg-surface-pearl dark:bg-[#272729] border border-hairline dark:border-neutral-700 rounded-xl px-3.5 py-2 text-ink dark:text-white outline-none focus:ring-2 focus:ring-[#0066cc]" />
        </div>

        <div>
          <label class="block font-semibold text-ink dark:text-neutral-200 mb-1">URL Slug (Auto-generated)</label>
          <input type="text" id="edit-post-slug" placeholder="e.g. master-sap-abap-field-symbols" class="w-full bg-surface-pearl dark:bg-[#272729] border border-hairline dark:border-neutral-700 rounded-xl px-3.5 py-2 text-ink dark:text-white outline-none focus:ring-2 focus:ring-[#0066cc] font-mono text-[11px]" />
        </div>

        <div>
          <label class="block font-semibold text-ink dark:text-neutral-200 mb-1">Category *</label>
          <select id="edit-post-category" class="w-full bg-surface-pearl dark:bg-[#272729] border border-hairline dark:border-neutral-700 rounded-xl px-3.5 py-2 text-ink dark:text-white outline-none focus:ring-2 focus:ring-[#0066cc]">
            <option value="ABAP">SAP ABAP</option>
            <option value="Fiori">SAP Fiori</option>
            <option value="HANA">SAP HANA</option>
            <option value="BTP">SAP BTP</option>
            <option value="Basis">SAP Basis</option>
            <option value="Career">SAP Career & Jobs</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-ink dark:text-neutral-200 mb-1">Author Name</label>
          <input type="text" id="edit-post-author" value="SAP Community Author" class="w-full bg-surface-pearl dark:bg-[#272729] border border-hairline dark:border-neutral-700 rounded-xl px-3.5 py-2 text-ink dark:text-white outline-none focus:ring-2 focus:ring-[#0066cc]" />
        </div>
      </div>

      <div>
        <label class="block font-semibold text-ink dark:text-neutral-200 mb-1">Short Summary / Excerpt *</label>
        <textarea id="edit-post-desc" rows="2" placeholder="Brief 1-2 sentence description of the article..." class="w-full bg-surface-pearl dark:bg-[#272729] border border-hairline dark:border-neutral-700 rounded-xl p-3 text-ink dark:text-white outline-none focus:ring-2 focus:ring-[#0066cc]"></textarea>
      </div>

      <!-- IMAGE UPLOADER BOX -->
      <div class="p-4 bg-surface-pearl dark:bg-[#252527] rounded-xl border border-hairline dark:border-neutral-700 space-y-3">
        <div class="flex items-center justify-between">
          <label class="font-bold text-ink dark:text-white flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#0066cc]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            Upload Images & Diagrams
          </label>
          <span class="text-[11px] text-neutral-400">Supports PNG, JPG, WebP, SVG</span>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <input type="file" id="image-upload-input" accept="image/*" class="w-full text-xs text-neutral-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#0066cc] file:text-white hover:file:bg-[#0071e3] file:cursor-pointer" />
          
          <button id="insert-image-md-btn" type="button" class="px-3.5 py-2 bg-neutral-200 dark:bg-neutral-800 hover:bg-neutral-300 dark:hover:bg-neutral-700 text-ink dark:text-white rounded-xl text-xs font-medium transition-colors shrink-0 cursor-pointer">
            Insert Image in Body
          </button>
        </div>

        <!-- Image Preview Container -->
        <div id="image-preview-container" class="hidden items-center gap-3 pt-2">
          <img id="image-preview-img" src="" alt="Preview" class="h-16 w-24 object-cover rounded-lg border border-hairline dark:border-neutral-700" />
          <div class="text-[11px] space-y-0.5">
            <p class="font-semibold text-ink dark:text-white" id="image-preview-name">image.png</p>
            <p class="text-emerald-600 dark:text-emerald-400">Image converted & ready to embed!</p>
          </div>
        </div>
      </div>

      <!-- ARTICLE CONTENT EDITOR & PREVIEW -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="font-semibold text-ink dark:text-neutral-200">Article Content (Markdown Format)</label>
          <div class="flex items-center gap-2">
            <button id="editor-tab-write" type="button" class="px-2.5 py-1 rounded bg-[#0066cc] text-white font-semibold cursor-pointer">Write</button>
            <button id="editor-tab-preview" type="button" class="px-2.5 py-1 rounded bg-neutral-200 dark:bg-neutral-800 text-ink dark:text-neutral-300 font-semibold cursor-pointer">Preview HTML</button>
          </div>
        </div>

        <textarea id="edit-post-body" rows="10" placeholder="## Introduction&#10;&#10;Write your SAP guide content here using standard Markdown...&#10;&#10;```abap&#10;DATA: lv_text TYPE string VALUE 'Hello SAP'.&#10;WRITE: / lv_text.&#10;```" class="w-full bg-surface-pearl dark:bg-[#272729] border border-hairline dark:border-neutral-700 rounded-xl p-3 text-ink dark:text-white font-mono text-xs outline-none focus:ring-2 focus:ring-[#0066cc]"></textarea>
        
        <div id="edit-post-preview" class="hidden w-full bg-surface-pearl dark:bg-[#272729] border border-hairline dark:border-neutral-700 rounded-xl p-4 min-h-[220px] prose dark:prose-invert text-xs text-ink dark:text-neutral-200">
          <!-- Rendered Markdown HTML preview -->
        </div>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="px-6 py-4 border-t border-hairline dark:border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-3 bg-surface-pearl dark:bg-[#252527]">
      <div class="flex items-center gap-3">
        <label class="flex items-center gap-2 cursor-pointer font-medium text-ink dark:text-neutral-300 text-xs">
          <input type="checkbox" id="publish-as-draft-chk" class="w-4 h-4 rounded text-amber-500 focus:ring-amber-500" />
          Save as Draft
        </label>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <button id="download-md-file-btn" type="button" class="flex-1 sm:flex-none px-4 py-2 bg-neutral-200 dark:bg-neutral-800 hover:bg-neutral-300 dark:hover:bg-neutral-700 text-ink dark:text-white font-semibold rounded-xl transition-colors cursor-pointer">
          Download .md File
        </button>

        <button id="save-publish-article-btn" type="button" class="flex-1 sm:flex-none px-5 py-2 bg-[#0066cc] hover:bg-[#0071e3] text-white font-semibold rounded-xl transition-all shadow-md active:scale-95 cursor-pointer">
          🚀 Publish Article Now
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const editorModal = document.getElementById('article-editor-modal');
  const closeEditorModalBtn = document.getElementById('close-editor-modal-btn');
  const titleInput = document.getElementById('edit-post-title') as HTMLInputElement;
  const slugInput = document.getElementById('edit-post-slug') as HTMLInputElement;
  const catInput = document.getElementById('edit-post-category') as HTMLSelectElement;
  const authorInput = document.getElementById('edit-post-author') as HTMLInputElement;
  const descInput = document.getElementById('edit-post-desc') as HTMLTextAreaElement;
  const bodyInput = document.getElementById('edit-post-body') as HTMLTextAreaElement;
  const previewBox = document.getElementById('edit-post-preview');
  const draftChk = document.getElementById('publish-as-draft-chk') as HTMLInputElement;

  const writeTab = document.getElementById('editor-tab-write');
  const previewTab = document.getElementById('editor-tab-preview');

  const imgInput = document.getElementById('image-upload-input') as HTMLInputElement;
  const imgPreviewContainer = document.getElementById('image-preview-container');
  const imgPreviewImg = document.getElementById('image-preview-img') as HTMLImageElement;
  const imgPreviewName = document.getElementById('image-preview-name');
  const insertImgBtn = document.getElementById('insert-image-md-btn');

  const savePublishBtn = document.getElementById('save-publish-article-btn');
  const downloadMdBtn = document.getElementById('download-md-file-btn');

  let uploadedImageDataUrl = '';

  // Auto-slug generator
  titleInput?.addEventListener('input', () => {
    if (slugInput) {
      slugInput.value = titleInput.value
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-');
    }
  });

  // Handle Image Upload & Conversion
  imgInput?.addEventListener('change', (e: any) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (evt) => {
        uploadedImageDataUrl = evt.target?.result as string;
        if (imgPreviewImg) imgPreviewImg.src = uploadedImageDataUrl;
        if (imgPreviewName) imgPreviewName.textContent = file.name;
        if (imgPreviewContainer) imgPreviewContainer.classList.remove('hidden');
        if (imgPreviewContainer) imgPreviewContainer.classList.add('flex');
      };
      reader.readAsDataURL(file);
    }
  });

  // Insert Image into body
  insertImgBtn?.addEventListener('click', () => {
    if (!uploadedImageDataUrl) {
      alert('Please select an image file first!');
      return;
    }
    const imgMd = `\n![${imgPreviewName?.textContent || 'Image'}](${uploadedImageDataUrl})\n`;
    if (bodyInput) {
      bodyInput.value += imgMd;
    }
    alert('Image inserted into article content body!');
  });

  // Tab switching: Write vs Preview
  writeTab?.addEventListener('click', () => {
    writeTab.className = 'px-2.5 py-1 rounded bg-[#0066cc] text-white font-semibold cursor-pointer';
    previewTab!.className = 'px-2.5 py-1 rounded bg-neutral-200 dark:bg-neutral-800 text-ink dark:text-neutral-300 font-semibold cursor-pointer';
    bodyInput?.classList.remove('hidden');
    previewBox?.classList.add('hidden');
  });

  previewTab?.addEventListener('click', () => {
    previewTab.className = 'px-2.5 py-1 rounded bg-[#0066cc] text-white font-semibold cursor-pointer';
    writeTab!.className = 'px-2.5 py-1 rounded bg-neutral-200 dark:bg-neutral-800 text-ink dark:text-neutral-300 font-semibold cursor-pointer';
    bodyInput?.classList.add('hidden');
    previewBox?.classList.remove('hidden');

    // Simple markdown preview parser
    if (previewBox && bodyInput) {
      let html = bodyInput.value
        .replace(/^### (.*$)/gim, '<h3 class="text-base font-bold my-2">$1</h3>')
        .replace(/^## (.*$)/gim, '<h2 class="text-lg font-bold my-3">$1</h2>')
        .replace(/^# (.*$)/gim, '<h1 class="text-xl font-bold my-4">$1</h1>')
        .replace(/\*\*(.*)\*\*/gim, '<strong>$1</strong>')
        .replace(/\*(.*)\*/gim, '<em>$1</em>')
        .replace(/!\[(.*?)\]\((.*?)\)/gim, '<img alt="$1" src="$2" class="my-3 rounded-lg max-h-60 object-cover border" />')
        .replace(/\n/g, '<br />');
      previewBox.innerHTML = html || '<p class="text-neutral-400 italic">Nothing to preview yet...</p>';
    }
  });

  closeEditorModalBtn?.addEventListener('click', () => {
    editorModal?.classList.add('hidden');
  });

  // Save / Publish Logic
  savePublishBtn?.addEventListener('click', () => {
    if (!titleInput.value.trim() || !descInput.value.trim()) {
      alert('Please fill in Article Title and Summary!');
      return;
    }

    const isDraft = draftChk.checked;
    const postData = {
      id: slugInput.value || Date.now().toString(),
      title: titleInput.value,
      description: descInput.value,
      category: catInput.value,
      author: authorInput.value || 'SAP Author',
      pubDate: new Date().toISOString().split('T')[0],
      readingTime: `${Math.max(1, Math.ceil(bodyInput.value.split(/\s+/).length / 200))} min`,
      status: isDraft ? 'Draft' : 'Published',
      content: bodyInput.value,
      created: new Date().toLocaleDateString()
    };

    // Store in localStorage custom posts
    const customPosts = JSON.parse(localStorage.getItem('user_created_posts') || '[]');
    customPosts.unshift(postData);
    localStorage.setItem('user_created_posts', JSON.stringify(customPosts));

    alert(`Article "${postData.title}" successfully ${isDraft ? 'saved as Draft' : 'Published'}!`);
    editorModal?.classList.add('hidden');

    // Trigger table update event
    window.dispatchEvent(new Event('refresh_posts_table'));
  });

  // Download .md File
  downloadMdBtn?.addEventListener('click', () => {
    const mdContent = `---
title: "${titleInput.value}"
description: "${descInput.value}"
pubDate: ${new Date().toISOString().split('T')[0]}
category: "${catInput.value}"
author: "${authorInput.value}"
readingTime: "${Math.max(1, Math.ceil(bodyInput.value.split(/\s+/).length / 200))} min"
---

${bodyInput.value}
`;
    const blob = new Blob([mdContent], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${slugInput.value || 'article'}.md`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Global trigger to open modal
  window.addEventListener('open_article_editor', () => {
    editorModal?.classList.remove('hidden');
    // Auto-fill logged in author
    const session = localStorage.getItem('admin_session') || sessionStorage.getItem('admin_session');
    if (session && authorInput) {
      try {
        const data = JSON.parse(session);
        if (data.username && data.username !== 'admin') {
          authorInput.value = data.username;
        }
      } catch(e){}
    }
  });
</script>
