---
// src/components/admin/UserPassGenerator.astro
---

<div class="user-pass-generator bg-white dark:bg-[#1c1c1e] rounded-2xl border border-hairline dark:border-neutral-800 p-6 md:p-8 shadow-sm transition-all">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-hairline dark:border-neutral-800 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff] text-xs font-semibold uppercase tracking-wider mb-2">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
        Security Suite
      </div>
      <h2 class="text-2xl font-bold text-ink dark:text-white tracking-tight">Username & Password Generator</h2>
      <p class="text-sm text-ink-muted-48 dark:text-neutral-400 mt-1">Generate high-entropy credentials for site administrators, authors, and system API access.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <button id="quick-gen-pair-btn" type="button" class="inline-flex items-center gap-2 px-4 py-2 bg-[#0066cc] hover:bg-[#0071e3] text-white rounded-full text-sm font-medium transition-all shadow-sm active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        Generate Admin Credentials Pair
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- LEFT PANEL: USERNAME GENERATOR -->
    <div class="space-y-6 bg-surface-pearl dark:bg-[#272729] p-5 md:p-6 rounded-xl border border-hairline dark:border-neutral-700/50">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-ink dark:text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-[#0066cc] dark:text-[#2997ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          Username Generator
        </h3>
        <span class="text-xs bg-canvas dark:bg-[#1c1c1e] text-ink-muted-80 dark:text-neutral-300 px-2.5 py-1 rounded-md border border-hairline dark:border-neutral-700">Custom Rules</span>
      </div>

      <div class="space-y-4 text-sm">
        <div>
          <label class="block font-medium text-ink dark:text-neutral-200 mb-1.5">User Role & Style Preset</label>
          <select id="user-preset" class="w-full bg-white dark:bg-[#1c1c1e] border border-hairline dark:border-neutral-700 rounded-lg px-3 py-2 text-ink dark:text-white focus:ring-2 focus:ring-[#0066cc] outline-none">
            <option value="superadmin">Super Admin (e.g., admin_sap_lead, super_sysadmin)</option>
            <option value="editor">Content Editor (e.g., ed_abap_pro, editor_fiori)</option>
            <option value="developer">SAP Developer (e.g., dev_hana_expert, abap_wizard)</option>
            <option value="random">Random Memorable (e.g., cyan_falcon_92, bold_nexus_47)</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-medium text-ink dark:text-neutral-200 mb-1.5">Prefix (Optional)</label>
            <input type="text" id="user-prefix" placeholder="e.g. sap_" class="w-full bg-white dark:bg-[#1c1c1e] border border-hairline dark:border-neutral-700 rounded-lg px-3 py-2 text-ink dark:text-white focus:ring-2 focus:ring-[#0066cc] outline-none placeholder:text-neutral-400" />
          </div>
          <div>
            <label class="block font-medium text-ink dark:text-neutral-200 mb-1.5">Suffix (Optional)</label>
            <input type="text" id="user-suffix" placeholder="e.g. _2026" class="w-full bg-white dark:bg-[#1c1c1e] border border-hairline dark:border-neutral-700 rounded-lg px-3 py-2 text-ink dark:text-white focus:ring-2 focus:ring-[#0066cc] outline-none placeholder:text-neutral-400" />
          </div>
        </div>

        <div class="flex items-center gap-4 pt-1">
          <label class="flex items-center gap-2 cursor-pointer text-ink dark:text-neutral-300">
            <input type="checkbox" id="user-digits" checked class="w-4 h-4 rounded text-[#0066cc] focus:ring-[#0066cc]" />
            Include Random Digits
          </label>
          <label class="flex items-center gap-2 cursor-pointer text-ink dark:text-neutral-300">
            <input type="checkbox" id="user-separators" checked class="w-4 h-4 rounded text-[#0066cc] focus:ring-[#0066cc]" />
            Use Underscores/Hyphens
          </label>
        </div>

        <button id="gen-username-btn" type="button" class="w-full py-2.5 bg-ink text-white dark:bg-white dark:text-ink font-medium rounded-lg hover:opacity-90 transition-opacity flex items-center justify-center gap-2 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          Generate Username
        </button>

        <div class="pt-2">
          <label class="block text-xs font-semibold text-ink-muted-48 dark:text-neutral-400 mb-1 uppercase tracking-wider">Generated Username</label>
          <div class="flex items-center gap-2 bg-white dark:bg-[#1c1c1e] border border-hairline dark:border-neutral-700 p-2.5 rounded-lg">
            <input type="text" id="output-username" readonly value="admin_sap_master_99" class="w-full bg-transparent font-mono text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] outline-none" />
            <button id="copy-username-btn" type="button" class="px-3 py-1 bg-surface-pearl dark:bg-neutral-800 hover:bg-hairline dark:hover:bg-neutral-700 text-ink dark:text-white rounded text-xs font-medium transition-all flex items-center gap-1 cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 012-2v-8a2 2 0 01-2-2h-8a2 2 0 01-2 2v8a2 2 0 012 2z"></path></svg>
              <span>Copy</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT PANEL: PASSWORD GENERATOR -->
    <div class="space-y-6 bg-surface-pearl dark:bg-[#272729] p-5 md:p-6 rounded-xl border border-hairline dark:border-neutral-700/50">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-ink dark:text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-[#0066cc] dark:text-[#2997ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 0121 9z"></path></svg>
          Password Generator
        </h3>
        <span id="entropy-badge" class="text-xs bg-green-500/10 text-green-600 dark:text-green-400 font-semibold px-2.5 py-1 rounded-md border border-green-500/20">High Entropy</span>
      </div>

      <div class="space-y-4 text-sm">
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label class="font-medium text-ink dark:text-neutral-200">Password Length</label>
            <span id="pass-length-val" class="font-mono font-bold text-[#0066cc] dark:text-[#2997ff] text-base">20</span>
          </div>
          <input type="range" id="pass-length" min="8" max="64" value="20" class="w-full accent-[#0066cc] cursor-pointer" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center gap-2 cursor-pointer bg-white dark:bg-[#1c1c1e] p-2.5 rounded-lg border border-hairline dark:border-neutral-700 text-ink dark:text-neutral-300">
            <input type="checkbox" id="pass-uppercase" checked class="w-4 h-4 rounded text-[#0066cc] focus:ring-[#0066cc]" />
            ABC (Uppercase)
          </label>
          <label class="flex items-center gap-2 cursor-pointer bg-white dark:bg-[#1c1c1e] p-2.5 rounded-lg border border-hairline dark:border-neutral-700 text-ink dark:text-neutral-300">
            <input type="checkbox" id="pass-lowercase" checked class="w-4 h-4 rounded text-[#0066cc] focus:ring-[#0066cc]" />
            abc (Lowercase)
          </label>
          <label class="flex items-center gap-2 cursor-pointer bg-white dark:bg-[#1c1c1e] p-2.5 rounded-lg border border-hairline dark:border-neutral-700 text-ink dark:text-neutral-300">
            <input type="checkbox" id="pass-numbers" checked class="w-4 h-4 rounded text-[#0066cc] focus:ring-[#0066cc]" />
            123 (Numbers)
          </label>
          <label class="flex items-center gap-2 cursor-pointer bg-white dark:bg-[#1c1c1e] p-2.5 rounded-lg border border-hairline dark:border-neutral-700 text-ink dark:text-neutral-300">
            <input type="checkbox" id="pass-symbols" checked class="w-4 h-4 rounded text-[#0066cc] focus:ring-[#0066cc]" />
            !@# (Symbols)
          </label>
        </div>

        <button id="gen-password-btn" type="button" class="w-full py-2.5 bg-[#0066cc] text-white font-medium rounded-lg hover:bg-[#0071e3] transition-colors flex items-center justify-center gap-2 shadow-sm cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          Generate Secure Password
        </button>

        <div class="pt-2">
          <div class="flex justify-between items-center mb-1">
            <label class="text-xs font-semibold text-ink-muted-48 dark:text-neutral-400 uppercase tracking-wider">Generated Password</label>
            <span id="pass-strength-label" class="text-xs font-semibold text-green-600 dark:text-green-400">Very Strong (128 bits)</span>
          </div>

          <!-- Strength Bar -->
          <div class="w-full bg-neutral-200 dark:bg-neutral-700 h-1.5 rounded-full overflow-hidden mb-2">
            <div id="pass-strength-bar" class="bg-green-500 h-full w-full transition-all duration-300"></div>
          </div>

          <div class="flex items-center gap-2 bg-white dark:bg-[#1c1c1e] border border-hairline dark:border-neutral-700 p-2.5 rounded-lg">
            <input type="text" id="output-password" readonly value="K9#mP$9xL2@qZ8!wN4&v" class="w-full bg-transparent font-mono text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] outline-none" />
            <button id="copy-password-btn" type="button" class="px-3 py-1 bg-surface-pearl dark:bg-neutral-800 hover:bg-hairline dark:hover:bg-neutral-700 text-ink dark:text-white rounded text-xs font-medium transition-all flex items-center gap-1 cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 012-2v-8a2 2 0 01-2-2h-8a2 2 0 01-2 2v8a2 2 0 012 2z"></path></svg>
              <span>Copy</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SAVED CREDENTIALS / MASTER ACTIONS -->
  <div class="mt-8 pt-6 border-t border-hairline dark:border-neutral-800">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
      <div>
        <h3 class="text-lg font-bold text-ink dark:text-white">Active Credential Vault & Management</h3>
        <p class="text-xs text-ink-muted-48 dark:text-neutral-400">Save generated credentials to local session state or update Super Admin credentials.</p>
      </div>

      <div class="flex items-center gap-2">
        <button id="save-to-vault-btn" type="button" class="px-3.5 py-1.5 bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-ink dark:text-white text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer">
          <svg class="w-3.5 h-3.5 text-[#0066cc] dark:text-[#2997ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Save Current Pair to Vault
        </button>

        <button id="set-as-master-btn" type="button" class="px-3.5 py-1.5 bg-[#0066cc]/10 hover:bg-[#0066cc]/20 text-[#0066cc] dark:text-[#2997ff] text-xs font-semibold rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          Set as Master Password
        </button>
      </div>
    </div>

    <!-- Vault Table -->
    <div class="overflow-x-auto border border-hairline dark:border-neutral-800 rounded-xl">
      <table class="w-full text-left text-xs">
        <thead class="bg-surface-pearl dark:bg-[#252527] text-ink dark:text-neutral-300 font-semibold border-b border-hairline dark:border-neutral-800">
          <tr>
            <th class="p-3">Username</th>
            <th class="p-3">Role</th>
            <th class="p-3">Password (Masked)</th>
            <th class="p-3">Created</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="vault-table-body" class="divide-y divide-hairline dark:divide-neutral-800 text-ink dark:text-neutral-300">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Generator Logic
  const adjectives = ['swift', 'bold', 'cyan', 'quantum', 'nexus', 'alpha', 'cyber', 'sap', 'abap', 'fiori', 'hana', 'btp', 'apex', 'vector', 'prime'];
  const nouns = ['admin', 'master', 'lead', 'dev', 'architect', 'expert', 'wizard', 'sentinel', 'falcon', 'titan', 'core', 'engine', 'runner', 'pilot'];

  const userPreset = document.getElementById('user-preset') as HTMLSelectElement;
  const userPrefix = document.getElementById('user-prefix') as HTMLInputElement;
  const userSuffix = document.getElementById('user-suffix') as HTMLInputElement;
  const userDigits = document.getElementById('user-digits') as HTMLInputElement;
  const userSeparators = document.getElementById('user-separators') as HTMLInputElement;
  const genUserBtn = document.getElementById('gen-username-btn');
  const outputUser = document.getElementById('output-username') as HTMLInputElement;
  const copyUserBtn = document.getElementById('copy-username-btn');

  const passLength = document.getElementById('pass-length') as HTMLInputElement;
  const passLengthVal = document.getElementById('pass-length-val');
  const passUpper = document.getElementById('pass-uppercase') as HTMLInputElement;
  const passLower = document.getElementById('pass-lowercase') as HTMLInputElement;
  const passNum = document.getElementById('pass-numbers') as HTMLInputElement;
  const passSym = document.getElementById('pass-symbols') as HTMLInputElement;
  const genPassBtn = document.getElementById('gen-password-btn');
  const outputPass = document.getElementById('output-password') as HTMLInputElement;
  const copyPassBtn = document.getElementById('copy-password-btn');
  const passStrengthBar = document.getElementById('pass-strength-bar');
  const passStrengthLabel = document.getElementById('pass-strength-label');
  const entropyBadge = document.getElementById('entropy-badge');

  const quickGenPairBtn = document.getElementById('quick-gen-pair-btn');
  const saveToVaultBtn = document.getElementById('save-to-vault-btn');
  const setAsMasterBtn = document.getElementById('set-as-master-btn');
  const vaultTableBody = document.getElementById('vault-table-body');

  let vault = JSON.parse(localStorage.getItem('admin_credentials_vault') || '[]');

  if (vault.length === 0) {
    vault = [
      { id: '1', username: 'admin', role: 'Super Admin (Default)', password: 'SuperAdmin2026!SecureKey', created: new Date().toLocaleDateString() },
      { id: '2', username: 'ed_abap_master', role: 'Content Editor', password: 'K9#mP$9xL2@qZ8!wN4&v', created: new Date().toLocaleDateString() }
    ];
    localStorage.setItem('admin_credentials_vault', JSON.stringify(vault));
  }

  function renderVault() {
    if (!vaultTableBody) return;
    vaultTableBody.innerHTML = vault.map((item: any) => `
      <tr class="hover:bg-surface-pearl dark:hover:bg-neutral-800/50 transition-colors">
        <td class="p-3 font-mono font-medium text-[#0066cc] dark:text-[#2997ff]">${item.username}</td>
        <td class="p-3"><span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-[#1d1d1f] dark:text-neutral-300 text-[11px] font-medium">${item.role}</span></td>
        <td class="p-3 font-mono text-neutral-500 dark:text-neutral-400">••••••••••••••••</td>
        <td class="p-3 text-neutral-500 dark:text-neutral-400">${item.created}</td>
        <td class="p-3 text-right space-x-2">
          <button onclick="navigator.clipboard.writeText('${item.username}'); alert('Copied username!');" class="hover:text-[#0066cc] font-medium cursor-pointer">Copy User</button>
          <button onclick="navigator.clipboard.writeText('${item.password}'); alert('Copied password!');" class="hover:text-[#0066cc] font-medium cursor-pointer">Copy Pass</button>
          ${item.username !== 'admin' ? `<button onclick="window.deleteVaultItem('${item.id}')" class="text-red-500 hover:text-red-600 font-medium cursor-pointer">Delete</button>` : ''}
        </td>
      </tr>
    `).join('');
  }

  (window as any).deleteVaultItem = (id: string) => {
    vault = vault.filter((i: any) => i.id !== id);
    localStorage.setItem('admin_credentials_vault', JSON.stringify(vault));
    renderVault();
  };

  function generateUsername() {
    if (!outputUser || !userPreset) return;
    const preset = userPreset.value;
    const prefix = userPrefix.value.trim();
    const suffix = userSuffix.value.trim();
    const digits = userDigits.checked;
    const sep = userSeparators.checked ? '_' : '';

    let base = '';
    if (preset === 'superadmin') {
      base = `admin${sep}sap${sep}master`;
    } else if (preset === 'editor') {
      base = `ed${sep}abap${sep}pro`;
    } else if (preset === 'developer') {
      base = `dev${sep}hana${sep}expert`;
    } else {
      const adj = adjectives[Math.floor(Math.random() * adjectives.length)];
      const noun = nouns[Math.floor(Math.random() * nouns.length)];
      base = `${adj}${sep}${noun}`;
    }

    let result = base;
    if (prefix) result = `${prefix}${result}`;
    if (suffix) result = `${result}${suffix}`;
    if (digits) result += `${sep}${Math.floor(10 + Math.random() * 90)}`;

    outputUser.value = result;
  }

  function generatePassword() {
    if (!outputPass || !passLength) return;
    const len = parseInt(passLength.value, 10);
    const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const lower = 'abcdefghijklmnopqrstuvwxyz';
    const num = '0123456789';
    const sym = '!@#$%^&*()_+-=[]{}|;:,.<>?';

    let charset = '';
    if (passUpper?.checked) charset += upper;
    if (passLower?.checked) charset += lower;
    if (passNum?.checked) charset += num;
    if (passSym?.checked) charset += sym;

    if (!charset) {
      alert('Please select at least one character set!');
      if (passLower) passLower.checked = true;
      charset = lower;
    }

    let password = '';
    const array = new Uint32Array(len);
    crypto.getRandomValues(array);
    for (let i = 0; i < len; i++) {
      password += charset[array[i] % charset.length];
    }

    outputPass.value = password;

    // Calculate Entropy
    const poolSize = charset.length;
    const entropy = Math.round(len * Math.log2(poolSize));

    if (passStrengthBar && passStrengthLabel && entropyBadge) {
      if (entropy < 40) {
        passStrengthBar.style.width = '25%';
        passStrengthBar.className = 'bg-red-500 h-full transition-all duration-300';
        passStrengthLabel.textContent = `Weak (${entropy} bits)`;
        passStrengthLabel.className = 'text-xs font-semibold text-red-500';
        entropyBadge.textContent = 'Low Entropy';
        entropyBadge.className = 'text-xs bg-red-500/10 text-red-600 dark:text-red-400 font-semibold px-2.5 py-1 rounded-md border border-red-500/20';
      } else if (entropy < 65) {
        passStrengthBar.style.width = '55%';
        passStrengthBar.className = 'bg-yellow-500 h-full transition-all duration-300';
        passStrengthLabel.textContent = `Moderate (${entropy} bits)`;
        passStrengthLabel.className = 'text-xs font-semibold text-yellow-600 dark:text-yellow-400';
        entropyBadge.textContent = 'Moderate Entropy';
        entropyBadge.className = 'text-xs bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 font-semibold px-2.5 py-1 rounded-md border border-yellow-500/20';
      } else {
        passStrengthBar.style.width = '100%';
        passStrengthBar.className = 'bg-green-500 h-full transition-all duration-300';
        passStrengthLabel.textContent = `Very Strong (${entropy} bits)`;
        passStrengthLabel.className = 'text-xs font-semibold text-green-600 dark:text-green-400';
        entropyBadge.textContent = 'High Entropy';
        entropyBadge.className = 'text-xs bg-green-500/10 text-green-600 dark:text-green-400 font-semibold px-2.5 py-1 rounded-md border border-green-500/20';
      }
    }
  }

  // Event Listeners
  genUserBtn?.addEventListener('click', generateUsername);
  genPassBtn?.addEventListener('click', generatePassword);

  passLength?.addEventListener('input', () => {
    if (passLengthVal) passLengthVal.textContent = passLength.value;
    generatePassword();
  });

  [passUpper, passLower, passNum, passSym].forEach(chk => {
    chk?.addEventListener('change', generatePassword);
  });

  quickGenPairBtn?.addEventListener('click', () => {
    generateUsername();
    generatePassword();
  });

  copyUserBtn?.addEventListener('click', () => {
    if (!outputUser) return;
    navigator.clipboard.writeText(outputUser.value);
    const span = copyUserBtn.querySelector('span');
    if (span) {
      span.textContent = 'Copied!';
      setTimeout(() => { span.textContent = 'Copy'; }, 2000);
    }
  });

  copyPassBtn?.addEventListener('click', () => {
    if (!outputPass) return;
    navigator.clipboard.writeText(outputPass.value);
    const span = copyPassBtn.querySelector('span');
    if (span) {
      span.textContent = 'Copied!';
      setTimeout(() => { span.textContent = 'Copy'; }, 2000);
    }
  });

  saveToVaultBtn?.addEventListener('click', () => {
    if (!outputUser || !outputPass || !userPreset) return;
    const newItem = {
      id: Date.now().toString(),
      username: outputUser.value,
      role: userPreset.options[userPreset.selectedIndex].text.split('(')[0].trim(),
      password: outputPass.value,
      created: new Date().toLocaleDateString()
    };
    vault.push(newItem);
    localStorage.setItem('admin_credentials_vault', JSON.stringify(vault));
    renderVault();
    alert(`Saved credential pair for "${newItem.username}" to Vault!`);
  });

  setAsMasterBtn?.addEventListener('click', () => {
    if (!outputPass) return;
    const newMasterPass = outputPass.value;
    if (confirm(`Are you sure you want to update the Super Admin master password to: ${newMasterPass}?`)) {
      localStorage.setItem('admin_master_password', newMasterPass);
      alert('Master password updated successfully! Use this password for future logins.');
    }
  });

  // Init
  generateUsername();
  generatePassword();
  renderVault();
</script>
