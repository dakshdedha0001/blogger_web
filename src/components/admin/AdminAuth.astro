---
// src/components/admin/AdminAuth.astro
---

<div id="admin-auth-container" class="min-h-[80vh] flex flex-col justify-center items-center py-12 px-4">
  
  <!-- UNAUTHENTICATED LOGIN CARD -->
  <div id="admin-login-card" class="w-full max-w-md bg-white dark:bg-[#1c1c1e] rounded-3xl border border-hairline dark:border-neutral-800 p-8 shadow-xl transition-all">
    <div class="text-center mb-8">
      <div class="w-14 h-14 bg-[#0066cc]/10 dark:bg-[#2997ff]/20 text-[#0066cc] dark:text-[#2997ff] rounded-2xl flex items-center justify-center mx-auto mb-4 border border-[#0066cc]/20">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
      </div>
      <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] bg-[#0066cc]/10 px-3 py-1 rounded-full">Secure Portal</span>
      <h1 class="text-2xl font-bold text-ink dark:text-white mt-3 tracking-tight">Super Admin Panel</h1>
      <p class="text-xs text-ink-muted-48 dark:text-neutral-400 mt-1">Enter master administrative credentials to access website management suite.</p>
    </div>

    <!-- Error Alert Box -->
    <div id="login-error-alert" class="hidden mb-6 p-3.5 bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-xs font-medium rounded-xl flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span id="login-error-text">Invalid username or password. Please try again.</span>
    </div>

    <form id="admin-login-form" class="space-y-5">
      <div>
        <label for="admin-username-input" class="block text-xs font-semibold text-ink dark:text-neutral-200 mb-1.5 uppercase tracking-wider">Username</label>
        <div class="relative">
          <input type="text" id="admin-username-input" required autocomplete="username" placeholder="e.g. admin" class="w-full bg-surface-pearl dark:bg-[#272729] border border-hairline dark:border-neutral-700 rounded-xl px-4 py-3 text-sm text-ink dark:text-white focus:ring-2 focus:ring-[#0066cc] outline-none transition-all placeholder:text-neutral-400" />
        </div>
      </div>

      <div>
        <div class="flex justify-between items-center mb-1.5">
          <label for="admin-password-input" class="block text-xs font-semibold text-ink dark:text-neutral-200 uppercase tracking-wider">Master Password</label>
          <span class="text-[11px] text-[#0066cc] dark:text-[#2997ff] hover:underline cursor-pointer" id="show-hint-btn">Default Hint</span>
        </div>
        <div class="relative">
          <input type="password" id="admin-password-input" required autocomplete="current-password" placeholder="••••••••••••••••" class="w-full bg-surface-pearl dark:bg-[#272729] border border-hairline dark:border-neutral-700 rounded-xl px-4 py-3 text-sm text-ink dark:text-white focus:ring-2 focus:ring-[#0066cc] outline-none transition-all placeholder:text-neutral-400 pr-10" />
          <button type="button" id="toggle-pass-visibility" class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-ink dark:hover:text-white transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          </button>
        </div>
      </div>

      <!-- Remember Me & Lockout Info -->
      <div class="flex items-center justify-between text-xs pt-1">
        <label class="flex items-center gap-2 cursor-pointer text-ink dark:text-neutral-300">
          <input type="checkbox" id="remember-session" checked class="w-4 h-4 rounded text-[#0066cc] focus:ring-[#0066cc]" />
          Remember Session (24 hours)
        </label>
      </div>

      <button type="submit" id="admin-login-submit" class="w-full py-3 bg-[#0066cc] hover:bg-[#0071e3] text-white font-medium text-sm rounded-xl transition-all shadow-md active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
        <span>Authenticate & Unlock Admin Panel</span>
      </button>
    </form>

    <!-- Credential Hint Box (Toggled) -->
    <div id="credential-hint-box" class="hidden mt-6 p-4 bg-surface-pearl dark:bg-[#252527] rounded-xl border border-hairline dark:border-neutral-700 text-xs text-ink-muted-80 dark:text-neutral-300 space-y-1">
      <p class="font-semibold text-ink dark:text-white flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-[#0066cc]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Default Initial Access Credentials:
      </p>
      <p><strong>Username:</strong> <code class="font-mono text-[#0066cc] dark:text-[#2997ff]">admin</code></p>
      <p><strong>Password:</strong> <code class="font-mono text-[#0066cc] dark:text-[#2997ff]">SuperAdmin2026!SecureKey</code></p>
      <p class="text-[10px] text-neutral-400 mt-1">You can generate new passwords and update master access anytime inside the security panel.</p>
    </div>
  </div>

  <!-- AUTHENTICATED CONTENT CONTAINER -->
  <div id="admin-authenticated-wrapper" class="hidden w-full max-w-[1280px] mx-auto">
    <slot />
  </div>

</div>

<script>
  const loginCard = document.getElementById('admin-login-card');
  const authWrapper = document.getElementById('admin-authenticated-wrapper');
  const loginForm = document.getElementById('admin-login-form') as HTMLFormElement;
  const userInput = document.getElementById('admin-username-input') as HTMLInputElement;
  const passInput = document.getElementById('admin-password-input') as HTMLInputElement;
  const errorAlert = document.getElementById('login-error-alert');
  const errorText = document.getElementById('login-error-text');
  const togglePassBtn = document.getElementById('toggle-pass-visibility');
  const hintBtn = document.getElementById('show-hint-btn');
  const hintBox = document.getElementById('credential-hint-box');
  const rememberSession = document.getElementById('remember-session') as HTMLInputElement;

  function checkSession() {
    const session = localStorage.getItem('admin_session') || sessionStorage.getItem('admin_session');
    if (session) {
      const data = JSON.parse(session);
      if (Date.now() < data.expiresAt) {
        // Authenticated
        if (loginCard) loginCard.classList.add('hidden');
        if (authWrapper) authWrapper.classList.remove('hidden');
        return;
      } else {
        localStorage.removeItem('admin_session');
        sessionStorage.removeItem('admin_session');
      }
    }

    if (loginCard) loginCard.classList.remove('hidden');
    if (authWrapper) authWrapper.classList.add('hidden');
  }

  // Handle Login Submission
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const enteredUser = userInput.value.trim();
    const enteredPass = passInput.value;

    const masterPass = localStorage.getItem('admin_master_password') || 'SuperAdmin2026!SecureKey';
    
    // Check against vault or master password
    const vault = JSON.parse(localStorage.getItem('admin_credentials_vault') || '[]');
    const matchingAccount = vault.find((a: any) => a.username === enteredUser && a.password === enteredPass);

    if ((enteredUser === 'admin' && enteredPass === masterPass) || matchingAccount) {
      const expiresAt = Date.now() + (rememberSession.checked ? 24 * 60 * 60 * 1000 : 2 * 60 * 60 * 1000);
      const sessionData = JSON.stringify({ username: enteredUser, role: 'Super Admin', expiresAt });

      if (rememberSession.checked) {
        localStorage.setItem('admin_session', sessionData);
      } else {
        sessionStorage.setItem('admin_session', sessionData);
      }

      if (errorAlert) errorAlert.classList.add('hidden');
      checkSession();
      // Reload or trigger dashboard refresh
      window.dispatchEvent(new Event('admin_login_success'));
    } else {
      if (errorAlert && errorText) {
        errorAlert.classList.remove('hidden');
        errorText.textContent = 'Invalid username or password. Check default hint below or reset credentials.';
      }
    }
  });

  // Toggle Password Masking
  togglePassBtn?.addEventListener('click', () => {
    if (passInput) {
      const isPass = passInput.type === 'password';
      passInput.type = isPass ? 'text' : 'password';
    }
  });

  // Toggle Hint Box
  hintBtn?.addEventListener('click', () => {
    hintBox?.classList.toggle('hidden');
  });

  // Check session on load
  checkSession();

  // Listen for global logout signal
  window.addEventListener('admin_logout', () => {
    localStorage.removeItem('admin_session');
    sessionStorage.removeItem('admin_session');
    checkSession();
  });
</script>
