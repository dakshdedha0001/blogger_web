---
// src/components/GlobalNav.astro
// src/components/GlobalNav.astro
import { Image } from 'astro:assets';
---

<nav class="bg-surface-black text-body-on-dark h-[44px] sticky top-0 z-50 w-full">
  <div class="max-w-[1024px] mx-auto h-full px-4 md:px-[24px] flex items-center justify-between font-nav-link">
    <!-- Logo Image -->
    <a href="/" class="flex items-center hover:opacity-90 transition-opacity">
      <Image 
        src="/logo.png" 
        alt="Learn SAP Free"
        width={150}
        height={28}
        class="h-[28px] w-auto object-contain"
        style="filter: invert(1) brightness(1.5) contrast(1.2);"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-[12px] h-full">
      <!-- Blog Dropdown Container -->
      <div class="relative group h-full flex items-center" id="blog-nav-container">
        <button 
          id="blog-nav-trigger"
          class="opacity-80 hover:opacity-100 transition-all flex items-center gap-1 bg-transparent border-none text-body-on-dark cursor-pointer font-nav-link h-full outline-none"
          aria-expanded="false"
          aria-haspopup="true"
        >
          Blog
          <svg class="w-2.5 h-2.5 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <!-- Dropdown Menu Box -->
        <div 
          id="blog-nav-dropdown"
          class="absolute left-1/2 -translate-x-1/2 top-[44px] hidden group-hover:block w-[170px] bg-[#1d1d1f]/95 backdrop-blur-md border border-white/10 rounded-sm py-2 shadow-2xl z-[100] transition-all duration-155"
        >
          <a href="/blog" class="block px-4 py-2 text-[12px] text-body-on-dark opacity-80 hover:opacity-100 hover:bg-white/10 transition-colors">All Guides</a>
          <a href="/blog?category=ABAP%20Programming" class="block px-4 py-2 text-[12px] text-body-on-dark opacity-80 hover:opacity-100 hover:bg-white/10 transition-colors">ABAP Programming</a>
          <a href="/blog?category=Data%20Dictionary" class="block px-4 py-2 text-[12px] text-body-on-dark opacity-80 hover:opacity-100 hover:bg-white/10 transition-colors">Data Dictionary</a>
          <a href="/blog?category=SAP%20Careers" class="block px-4 py-2 text-[12px] text-body-on-dark opacity-80 hover:opacity-100 hover:bg-white/10 transition-colors">SAP Careers</a>
          <a href="/blog?category=SAP%20Fiori" class="block px-4 py-2 text-[12px] text-body-on-dark opacity-80 hover:opacity-100 hover:bg-white/10 transition-colors">SAP Fiori</a>
          <a href="/blog?category=SAP%20BTP" class="block px-4 py-2 text-[12px] text-primary-on-dark opacity-90 hover:opacity-100 hover:bg-white/10 transition-colors font-semibold font-nav-link">SAP BTP</a>
        </div>
      </div>
      <a href="/tcodes" class="opacity-80 hover:opacity-100 transition-opacity">T-Codes</a>
      <a href="/quiz" class="opacity-80 hover:opacity-100 transition-opacity">Quiz</a>
      <a href="/faq" class="opacity-80 hover:opacity-100 transition-opacity">FAQ</a>
      <a href="https://www.youtube.com/channel/UCTivqSC8zUouAkk-YZEqnKg" target="_blank" rel="noopener noreferrer" class="opacity-90 hover:opacity-100 text-primary-on-dark font-semibold transition-opacity">YouTube</a>
      <a href="/about" class="opacity-80 hover:opacity-100 transition-opacity">About</a>
      <a href="/contact" class="opacity-80 hover:opacity-100 transition-opacity">Contact</a>
      <a href="/privacy-policy" class="opacity-80 hover:opacity-100 transition-opacity">Privacy</a>
      <a href="/cookie-policy" class="opacity-80 hover:opacity-100 transition-opacity">Cookies</a>
      <a href="/disclaimer" class="opacity-80 hover:opacity-100 transition-opacity">Disclaimer</a>
      <a href="/terms-conditions" class="opacity-80 hover:opacity-100 transition-opacity">Terms</a>
    </div>
 
     <!-- Right-aligned utility triggers -->
     <div class="flex items-center gap-4">
       <!-- Spotlight Search trigger -->
       <button class="search-trigger-btn opacity-80 hover:opacity-100 transition-opacity bg-transparent border-none text-body-on-dark cursor-pointer focus:outline-none p-0 flex items-center gap-1.5" aria-label="Search site (Cmd+K)">
         <svg class="w-4 h-4 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24">
           <circle cx="11" cy="11" r="8"></circle>
           <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
         </svg>
         <kbd class="hidden lg:inline-flex items-center justify-center text-[10px] font-sans font-bold px-1.5 py-0.5 rounded border border-white/20 bg-white/10 select-none text-body-muted leading-none">
           ⌘K
         </kbd>
       </button>

        <!-- Theme Toggle Slider Switch -->
        <button class="theme-toggle-btn relative inline-flex h-[26px] w-[46px] shrink-0 items-center rounded-full border border-white/20 bg-white/10 hover:bg-white/15 dark:bg-primary/20 dark:hover:bg-primary/30 transition-colors duration-300 cursor-pointer focus:outline-none" aria-label="Toggle Theme">
          <!-- Sliding Knob -->
          <span class="theme-toggle-knob pointer-events-none relative flex items-center justify-center h-[20px] w-[20px] rounded-full bg-white shadow-md transition-transform duration-300 ease-in-out">
            <!-- Sun Icon (Light Mode) -->
            <svg class="sun-icon w-3.5 h-3.5 fill-none stroke-amber-500 stroke-[2.5] absolute transition-all duration-300" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon Icon (Dark Mode) -->
            <svg class="moon-icon w-3.5 h-3.5 fill-none stroke-slate-800 stroke-[2.5] absolute transition-all duration-300" viewBox="0 0 24 24">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </span>
        </button>


  
       <!-- Mobile Hamburger Button -->
       <button 
         id="menu-toggle"
         class="md:hidden opacity-80 hover:opacity-100 transition-opacity focus:outline-none cursor-pointer" 
         aria-label="Toggle Menu"
       >
         <svg id="menu-icon" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
           <rect y="4" width="24" height="2" rx="1"></rect>
           <rect y="11" width="24" height="2" rx="1"></rect>
           <rect y="18" width="24" height="2" rx="1"></rect>
         </svg>
       </button>
     </div>
   </div>
 
   <!-- Mobile Menu Tray -->
   <div 
     id="mobile-menu" 
     class="hidden fixed inset-x-0 top-[44px] bottom-0 bg-surface-black/95 backdrop-blur-md z-40 flex flex-col p-8 gap-6 text-[18px] font-normal overflow-y-auto"
   >
     <!-- Mobile Blog and Tracks -->
     <div class="flex flex-col border-b border-white/10 pb-4">
       <div class="flex items-center justify-between pb-2">
         <span class="text-white/40 text-[11px] uppercase font-bold tracking-wider">Training Tracks</span>
       </div>
       <div class="grid grid-cols-2 gap-x-4 gap-y-2.5 pl-2 mt-1">
         <a href="/blog" class="mobile-nav-link text-[15px] opacity-90 hover:opacity-100">All Guides</a>
         <a href="/blog?category=ABAP%20Programming" class="mobile-nav-link text-[15px] opacity-90 hover:opacity-100">ABAP Logic</a>
         <a href="/blog?category=Data%20Dictionary" class="mobile-nav-link text-[15px] opacity-90 hover:opacity-100">Data Dictionary</a>
         <a href="/blog?category=SAP%20Careers" class="mobile-nav-link text-[15px] opacity-90 hover:opacity-100">SAP Careers</a>
         <a href="/blog?category=SAP%20Fiori" class="mobile-nav-link text-[15px] opacity-90 hover:opacity-100">SAP Fiori</a>
         <a href="/blog?category=SAP%20BTP" class="mobile-nav-link text-[15px] text-primary-on-dark font-semibold">SAP BTP</a>
       </div>
     </div>
     <a href="/tcodes" class="mobile-nav-link border-b border-white/10 pb-4 opacity-90 hover:opacity-100">T-Code Lookup</a>
     <a href="/quiz" class="mobile-nav-link border-b border-white/10 pb-4 opacity-90 hover:opacity-100">Quiz Challenge</a>
     <a href="/faq" class="mobile-nav-link border-b border-white/10 pb-4 opacity-90 hover:opacity-100">FAQ Support</a>
     <a href="https://www.youtube.com/channel/UCTivqSC8zUouAkk-YZEqnKg" target="_blank" rel="noopener noreferrer" class="mobile-nav-link border-b border-white/10 pb-4 opacity-95 hover:opacity-100 text-primary-on-dark font-semibold">YouTube Channel</a>
     <a href="/about" class="mobile-nav-link border-b border-white/10 pb-4 opacity-90 hover:opacity-100">About Us</a>
     <a href="/contact" class="mobile-nav-link border-b border-white/10 pb-4 opacity-90 hover:opacity-100">Contact Us</a>
     <a href="/privacy-policy" class="mobile-nav-link border-b border-white/10 pb-4 opacity-90 hover:opacity-100">Privacy Policy</a>
     <a href="/cookie-policy" class="mobile-nav-link border-b border-white/10 pb-4 opacity-90 hover:opacity-100">Cookie Policy</a>
     <a href="/disclaimer" class="mobile-nav-link border-b border-white/10 pb-4 opacity-90 hover:opacity-100">Disclaimer</a>
     <a href="/terms-conditions" class="mobile-nav-link border-b border-white/10 pb-4 opacity-90 hover:opacity-100">Terms & Conditions</a>
  </div>
</nav>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    
    // Toggle active icon state
    if (mobileMenu?.classList.contains('hidden')) {
      if (menuIcon) {
        menuIcon.innerHTML = `
          <rect y="4" width="24" height="2" rx="1"></rect>
          <rect y="11" width="24" height="2" rx="1"></rect>
          <rect y="18" width="24" height="2" rx="1"></rect>
        `;
      }
    } else {
      if (menuIcon) {
        menuIcon.innerHTML = `
          <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        `;
      }
    }
  });

  // Close menu on navigation click
  const navLinks = document.querySelectorAll('.mobile-nav-link');
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      if (menuIcon) {
        menuIcon.innerHTML = `
          <rect y="4" width="24" height="2" rx="1"></rect>
          <rect y="11" width="24" height="2" rx="1"></rect>
          <rect y="18" width="24" height="2" rx="1"></rect>
        `;
      }
    });
  });
</script>
