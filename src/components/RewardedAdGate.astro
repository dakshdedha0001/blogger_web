---
// src/components/RewardedAdGate.astro — Automated GPT Rewarded Ad Script (No Manual Button)
---

<!-- User Provided GPT Rewarded Ad Script (Auto-triggers on page/blog load) -->
<script is:inline>
setTimeout(() => {

  const gpt = document.createElement("script");
  gpt.async = true;
  gpt.src = "https://securepubads.g.doubleclick.net/tag/js/gpt.js";

  gpt.onload = () => {

    window.googletag = window.googletag || { cmd: [] };

    let rewardedSlot = null;
    let rewardPayload = null;

    googletag.cmd.push(() => {

      rewardedSlot = googletag.defineOutOfPageSlot(
        "/23367961811/reward",
        googletag.enums.OutOfPageFormat.REWARDED
      );

      // Rewarded ads unsupported
      if (!rewardedSlot) {
        console.log("Rewarded ads not supported");
        return;
      }

      googletag.setConfig({
        adsenseAttributes: { page_url: "https://todaylimelight.com" }
      });

      rewardedSlot.addService(googletag.pubads());

      // Ad ready → auto show immediately without requiring manual button click
      googletag.pubads().addEventListener(
        "rewardedSlotReady",
        (event) => {

          console.log("Rewarded ad ready — auto showing");

          // AUTO SHOW AD
          event.makeRewardedVisible();
        }
      );

      // Video completed
      googletag.pubads().addEventListener(
        "rewardedSlotVideoCompleted",
        () => {
          console.log("Video completed");
        }
      );

      // Reward granted
      googletag.pubads().addEventListener(
        "rewardedSlotGranted",
        (event) => {

          rewardPayload = event.payload;

          console.log(
            "Reward granted:",
            rewardPayload.amount,
            rewardPayload.type
          );

          alert(
            `Reward Earned: ${rewardPayload.amount} ${rewardPayload.type}`
          );
        }
      );

      // Ad closed
      googletag.pubads().addEventListener(
        "rewardedSlotClosed",
        () => {

          console.log("Rewarded ad closed");

          if (rewardedSlot) {
            googletag.destroySlots([rewardedSlot]);
            rewardedSlot = null;
          }
        }
      );

      // No ad fill
      googletag.pubads().addEventListener(
        "slotRenderEnded",
        (event) => {

          if (event.slot === rewardedSlot && event.isEmpty) {
            console.log("No rewarded ad returned");
          }
        }
      );

      googletag.enableServices();

      // Request ad
      googletag.display(rewardedSlot);

    });

  };

  document.head.appendChild(gpt);

}, Math.floor(Math.random() * 0) + 000);
</script>
