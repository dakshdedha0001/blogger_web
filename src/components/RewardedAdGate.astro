---
// src/components/RewardedAdGate.astro
---

<!-- Fullscreen Centered Modal Overlay -->
<div id="rewarded-ad-gate-modal" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all duration-300">
  <div class="relative w-full max-w-lg bg-canvas dark:bg-[#1c1c1e] border border-hairline dark:border-white/10 rounded-3xl p-8 sm:p-10 shadow-2xl text-center overflow-hidden animate-in fade-in zoom-in-95 duration-300">
    <!-- Subtle background glows -->
    <div class="absolute -top-24 -right-24 w-48 h-48 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col items-center">
      <!-- Play / Video Badge Icon -->
      <div class="w-16 h-16 rounded-full bg-primary/10 border border-primary/20 text-primary flex items-center justify-center mb-6 shadow-sm">
        <svg class="w-8 h-8 fill-current translate-x-0.5" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>

      <!-- Main Headline requested by user -->
      <h2 class="font-display-lg text-[24px] sm:text-[28px] text-ink dark:text-white leading-tight font-semibold tracking-tight mb-3">
        To read all the content please view a short ad
      </h2>

      <!-- Subtext -->
      <p class="font-caption text-[15px] text-ink-muted-80 dark:text-gray-300 leading-relaxed mb-8">
        Watch a short sponsored video to unlock full access to this complete tutorial.
      </p>

      <!-- Action Button -->
      <button
        id="watch-rewarded-ad-btn"
        type="button"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 bg-primary hover:bg-primary-focus text-white font-body-strong text-[17px] rounded-full shadow-lg hover:shadow-primary/25 transition-all duration-200 cursor-pointer transform active:scale-95"
      >
        <svg class="w-5 h-5 fill-current text-white" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span>Watch Short Ad to Continue</span>
      </button>

      <!-- Loading / Status indicator -->
      <div id="ad-status-msg" class="mt-4 font-caption text-[13px] text-ink-muted-48 dark:text-gray-400 hidden flex items-center gap-2">
        <svg class="w-4 h-4 animate-spin text-primary" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span id="ad-status-text">Loading rewarded video ad...</span>
      </div>
    </div>
  </div>
</div>

<!-- Lock scroll initially when gate modal is visible -->
<script is:inline>
  if (typeof document !== 'undefined') {
    document.body.style.overflow = 'hidden';
  }
</script>

<!-- User Provided GPT Rewarded Ad Script -->
<script is:inline>
setTimeout(() => {

  const gpt = document.createElement("script");
  gpt.async = true;
  gpt.src = "https://securepubads.g.doubleclick.net/tag/js/gpt.js";

  gpt.onload = () => {

    window.googletag = window.googletag || { cmd: [] };

    let rewardedSlot = null;
    let rewardPayload = null;

    googletag.cmd.push(() => {

      rewardedSlot = googletag.defineOutOfPageSlot(
        "/23367961811/reward",
        googletag.enums.OutOfPageFormat.REWARDED
      );

      // Rewarded ads unsupported
      if (!rewardedSlot) {
        console.log("Rewarded ads not supported");
        return;
      }
      googletag.setConfig({
        adsenseAttributes: { page_url: "https://todaylimelight.com" }
      });

      rewardedSlot.addService(googletag.pubads());

      // Unlock helper function
      const unlockContent = () => {
        const modal = document.getElementById("rewarded-ad-gate-modal");
        if (modal) {
          modal.style.display = "none";
        }
        document.body.style.overflow = "";
      };

      // Ad ready → auto show immediately
      googletag.pubads().addEventListener(
        "rewardedSlotReady",
        (event) => {

          console.log("Rewarded ad ready");

          // AUTO SHOW AD
          event.makeRewardedVisible();
        }
      );

      // Video completed
      googletag.pubads().addEventListener(
        "rewardedSlotVideoCompleted",
        () => {
          console.log("Video completed");
          unlockContent();
        }
      );

      // Reward granted
      googletag.pubads().addEventListener(
        "rewardedSlotGranted",
        (event) => {

          rewardPayload = event.payload;

          console.log(
            "Reward granted:",
            rewardPayload.amount,
            rewardPayload.type
          );

          alert(
            `Reward Earned: ${rewardPayload.amount} ${rewardPayload.type}`
          );
          unlockContent();
        }
      );

      // Ad closed
      googletag.pubads().addEventListener(
        "rewardedSlotClosed",
        () => {

          console.log("Rewarded ad closed");

          if (rewardedSlot) {
            googletag.destroySlots([rewardedSlot]);
            rewardedSlot = null;
          }
          unlockContent();
        }
      );

      // No ad fill
      googletag.pubads().addEventListener(
        "slotRenderEnded",
        (event) => {

          if (event.slot === rewardedSlot && event.isEmpty) {
            console.log("No rewarded ad returned");
          }
        }
      );

      googletag.enableServices();

      // Request ad
      googletag.display(rewardedSlot);

      // Button manual trigger binding
      const watchBtn = document.getElementById("watch-rewarded-ad-btn");
      if (watchBtn) {
        watchBtn.addEventListener("click", () => {
          const statusMsg = document.getElementById("ad-status-msg");
          if (statusMsg) statusMsg.classList.remove("hidden");
          try {
            googletag.display(rewardedSlot);
          } catch (e) {
            console.log("Display trigger", e);
          }
        });
      }

    });

  };

  document.head.appendChild(gpt);

}, Math.floor(Math.random() * 0) + 000);
</script>
